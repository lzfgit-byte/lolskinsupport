g.cn/images/lol/act/img/skin/small_e584e8a4-01c2-447f-85f9-9612e9918eb3.jpg","loadingImg":"https://game.gtimg.cn/images/lol/act/img/skinloading/e584e8a4-01c2-447f-85f9-9612e9918eb3.jpg","videoImg":"https://game.gtimg.cn/images/lol/act/img/skinvideo/sp_e584e8a4-01c2-447f-85f9-9612e9918eb3.jpg","sourceImg":"https://game.gtimg.cn/images/lol/act/img/guidetop/guide_e584e8a4-01c2-447f-85f9-9612e9918eb3.jpg","vedioPath":"","suitType":"120","publishTime":"","chromaImg":"","centerImg":"https://game.gtimg.cn/images/lol/act/img/center/e584e8a4-01c2-447f-85f9-9612e9918eb3.jpg","instanceId":"e584e8a4-01c2-447f-85f9-9612e9918eb3"},{"skinId":"245057","heroId":"245","heroName":"时间刺客","heroTitle":"艾克","name":"双城之战2 孤勇者 艾克","chromas":"0","chromasBelongId":"0","isBase":"0","emblemsName":"Limited","description":"虽然皮尔特沃夫和祖安的未来尚不明朗，但有一件事绝不会变——那就是艾克始终会为自己所爱之人以及祖安的未来付出一切。以Z型驱动为武器的他，已经准备好为未来而战，即使困难重重，他也无所畏惧。幸运的是，这位救世主还藏了几手……","mainImg":"https://game.gtimg.cn/images/lol/act/img/skin/big_825920c7-38ad-449f-81cd-e289a18d0c31.jpg","iconImg":"https://game.gtimg.cn/images/lol/act/img/skin/small_825920c7-38ad-449f-81cd-e289a18d0c31.jpg","loadingImg":"https://game.gtimg.cn/images/lol/act/img/skinloading/825920c7-38ad-449f-81cd-e289a18d0c31.jpg","videoImg":"https://game.gtimg.cn/images/lol/act/img/skinvideo/sp_825920c7-38ad-449f-81cd-e289a18d0c31.jpg","sourceImg":"https://game.gtimg.cn/images/lol/act/img/guidetop/guide_825920c7-38ad-449f-81cd-e289a18d0c31.jpg","vedioPath":"","suitType":"152","publishTime":"","chromaImg":"","centerImg":"https://game.gtimg.cn/images/lol/act/img/center/825920c7-38ad-449f-81cd-e289a18d0c31.jpg","instanceId":"825920c7-38ad-449f-81cd-e289a18d0c31"},{"skinId":"245058","heroId":"245","heroName":"时间刺客","heroTitle":"艾克","name":"双城之战2 孤勇者 艾克 典范","chromas":"1","chromasBelongId":"245057","isBase":"0","emblemsName":"","description":"","mainImg":"","iconImg":"","loadingImg":"","videoImg":"","sourceImg":"","vedioPath":"","suitType":"","publishTime":"","chromaImg":"https://game.gtimg.cn/images/lol/act/img/skinloading/245/87baf2a7-2e04-4caa-9522-a67954976d7d.png","centerImg":"","instanceId":"87baf2a7-2e04-4caa-9522-a67954976d7d"}],"spells":[{"heroId":"245","spellKey":"e","name":"相位俯冲","description":"艾克突进并强化他的下次攻击，以获得额外距离、将他传送到他的目标处、并造成额外的(【50/75/100/125/150】 +40%【法术强度】)魔法伤害。\n艾克可以在突进期间使用他的任意其它技能。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/EkkoE.png","abilityVideoPath":"champion-abilities/0245/ability_0245_E1.webm","dynamicDescription":"艾克在为Z型驱动充能的同时灵巧地滚动。他的下次攻击将造成魔法伤害并扭曲时间，并让他传送到他的攻击目标旁。","cost":"40/45/50/55/60","costburn":"40/45/50/55/60","cooldown":"9/8.5/8/7.5/7","cooldownburn":"9/8.5/8/7.5/7","range":"325/325/325/325/325","cooldownupgrade":"9/8.5/8/7.5/7","costupgrade":"40/45/50/55/60"},{"heroId":"245","spellKey":"passive","name":"Z型驱动共振","description":"对相同目标的每第三次攻击或伤害型技能都会造成额外(30-140【随等级提升】+80%【法术强度】)魔法伤害。如果目标是一个英雄，那么艾克还会获得持续(2.0-3.0【随等级提升】)秒的(50%-80%【随等级提升】)移动速度。这个效果在4秒只能对相同目标生效一次。\n这个效果对野怪造成270%伤害。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/passive/Ekko_P.png","abilityVideoPath":"champion-abilities/0245/ability_0245_P1.webm","dynamicDescription":"每当艾克对相同目标施放第三次普攻或伤害性技能时，都会造成额外魔法伤害，并且如果目标是英雄，那么艾克还会获得爆发性的移动速度加成。<br><br>","cost":"","costburn":"","cooldown":"","cooldownburn":"","range":"","cooldownupgrade":"","costupgrade":""},{"heroId":"245","spellKey":"q","name":"时间卷曲器","description":"艾克投出一个设备，造成(【80/95/110/125/140】 +30%【法术强度】)魔法伤害。在命中一名英雄或到达它的距离终点后，它会扩展为一个领域来使其中的敌人减速【40%/45%/50%/55%/60%】。在它扩展后，艾克会将其召回，造成(【40/65/90/115/140】 +70%【法术强度】)魔法伤害。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/EkkoQ.png","abilityVideoPath":"champion-abilities/0245/ability_0245_Q1.webm","dynamicDescription":"艾克扔出一个时光手雷，这个手雷会在命中一个敌方英雄后扩展为一个时间扭曲的力场，对场内的所有敌方单位造成伤害和减速效果。然后它会在短暂的延迟后返回到艾克手上，返回途中会对沿途的敌人造成伤害。","cost":"40/50/60/70/80","costburn":"40/50/60/70/80","cooldown":"9/8.5/8/7.5/7","cooldownburn":"9/8.5/8/7.5/7","range":"1075/1075/1075/1075/1075","cooldownupgrade":"9/8.5/8/7.5/7","costupgrade":"40/50/60/70/80"},{"heroId":"245","spellKey":"r","name":"时空断裂","description":"艾克回到过去的时间点上，进入凝滞状态同时传送回他4秒前所在的位置，并在到达后对附近的所有敌人造成(【200/350/500】+175%【法术强度】)魔法伤害。此外，艾克会治疗自身(【100/150/200】 +60%【法术强度】)生命值，且最近4秒里每损失1%生命值就会使这个治疗效果提升3%。\n艾克在途经来自[W]时光交错的时空球体时会将它引爆。\n凝滞状态中的单位无法移动或行动，并且免疫伤害和不可被选取。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/EkkoR.png","abilityVideoPath":"champion-abilities/0245/ability_0245_R1.webm","dynamicDescription":"艾克打破他的时间线，变得不可被选取并回溯到一个更加有利的时间点上。他会回到几秒前的位置，并治疗这几秒内所受的伤势。在完成传送后，传送终点区域附近的敌人都会受到巨量伤害。","cost":"100/100/100","costburn":"100/100/100","cooldown":"110/80/50","cooldownburn":"110/80/50","range":"850/850/850","cooldownupgrade":"110/80/50","costupgrade":"100"},{"heroId":"245","spellKey":"w","name":"时光交错","description":"被动：艾克对生命值低于30%的敌方英雄进行的攻击会造成(3% +0.03%【法术强度】)已损失生命值的魔法伤害。\n主动：在1.5秒的延迟后，艾克放出一颗时空球体来使其中的敌人减速40%。如果艾克\n进入了球体，那么他会将其引爆，造成2.25秒晕眩并获得(【100/120/140/160/180】 +150%【法术强度】)护盾值。\n额外攻击伤害最少造成15伤害，并且对小兵和野怪最多造成150伤害。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/EkkoW.png","abilityVideoPath":"champion-abilities/0245/ability_0245_W1.webm","dynamicDescription":"艾克的普攻对低生命值的敌人造成额外魔法伤害。他可以施放【时光交错】来分离这条时间线，制造一个不稳定的异常时间点，这个时间点会在数秒后对范围内的敌人造成减速效果。如果艾克进入了这个异常时间点，那么他会获得护盾并让范围内的敌人因悬浮在时间中而陷入晕眩状态。","cost":"30/35/40/45/50","costburn":"30/35/40/45/50","cooldown":"22/20/18/16/14","cooldownburn":"22/20/18/16/14","range":"1600/1600/1600/1600/1600","cooldownupgrade":"22/20/18/16/14","costupgrade":"30/35/40/45/50"}],"version":"16.19","fileName":"245.js","fileTime":"2026-09-28 17:30:58"}