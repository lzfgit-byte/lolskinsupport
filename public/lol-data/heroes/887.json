0/40/40/40","cooldown":"6.5/5.75/5/4.25/3.5","cooldownburn":"6.5/5.75/5/4.25/3.5","range":"450/450/450/450/450","cooldownupgrade":"6.5/5.75/5/4.25/3.5","costupgrade":"40"},{"heroId":"887","spellKey":"r","name":"引针簇射","description":"第一段施放：掷出一根针来对命中的所有敌人造成(【30/50/70】 +10%【法术强度】)魔法伤害，以及持续1.5秒的40%减速，并施加千穿百孔。格温可以在6秒内再次施放这个技能至多2次(每次施放之间的冷却时间为1秒)。\n第二段施放：发射3根针来造成(【90/150/210】 +30%【法术强度】)魔法伤害\n第三段施放：发射5根针来造成(【150/250/350] +50%【法术强度】)魔法伤害\n命中相同单位的后续针的减速效果仅有15%。\n最大伤害：278=（270+90%法术强度），外加来自千穿百孔的9.49%（法术强度）最大生命值伤害。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/GwenR.png","abilityVideoPath":"a3237h4ennl","dynamicDescription":"格温掷出一根针来对命中的敌人们造成减速、魔法伤害，并对命中的英雄们施加【千穿百孔】。<br><br>这个技能至多可进行2段再次施放，每一段再次施放都会投掷更多的针，并造成更多伤害。 ","cost":"100/100/100","costburn":"100/100/100","cooldown":"120/100/80","cooldownburn":"120/100/80","range":"1200/1200/1200","cooldownupgrade":"120/100/80","costupgrade":"100"},{"heroId":"887","spellKey":"w","name":"丝缕缠流","description":"格温召唤圣霭结界，使她对结界之外的所有敌人(防御塔除外)来说处于无法被选取状态，持续4秒或直到她离开结界为止。在结界中，格温获得(22 +7%【法术强度】)护甲和魔法抗性。\n格温可以再次施放这个技能，来将结界召唤到她所在的位置，但只有1次机会。格温在第一次尝试离开结界时会自动进行再次施放。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/GwenW.png","abilityVideoPath":"i323744qq9u","dynamicDescription":"格温召唤圣霭来保护她免受圣霭外敌人的进攻。她只会被进入圣霭内的敌人们选为目标。","cost":"60/60/60/60/60","costburn":"60/60/60/60/60","cooldown":"22/21/20/19/18","cooldownburn":"22/21/20/19/18","range":"0/0/0/0/0","cooldownupgrade":"22/21/20/19/18","costupgrade":"60"}],"version":"16.19","fileName":"887.js","fileTime":"2026-09-28 17:31:01"}