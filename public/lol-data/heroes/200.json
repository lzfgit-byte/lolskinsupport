urn":"0/0/0/0/0","cooldown":"4/3.25/2.5/1.75/1","cooldownburn":"4/3.25/2.5/1.75/1","range":"450/450/450/450/450","cooldownupgrade":"4/3.25/2.5/1.75/1","costupgrade":"0"},{"heroId":"200","spellKey":"r","name":"万载豪筵","description":"被动：攻击会造成额外的(【2/4/6】+3%【额外攻击力】)真实伤害，可无限叠加。参与击杀英雄和野怪后会留下一片【虚空珊瑚】。\n主动：卑尔维斯消耗一块【虚空珊瑚】，从而获得1层【溶烛化紫】并激活她的真实形态。来自虚空史诗级野怪的【虚空珊瑚】会使附近阵亡的小兵们变为【虚空鱼】。在施放时，卑尔维斯减速附近的敌人们然后爆炸，造成(【150/200/250】+150%【法术强度】)+20%已损失生命值的真实伤害。\n在她的真实形态下，卑尔维斯获得(【100/250/400】+150%【额外攻击力】+150%【法术强度】)最大生命值、【25/75/125】移动距离、【6%/13%/20%】总攻击速度、并且虚空激流可以穿过墙体。\n真实形态持续45秒，在40层溶烛化紫时提升至90秒。在80层溶烛化紫时，真实伤害持续至阵亡为止。\n【虚空鱼】会被视作拥有【20%/45%/70%】生命值和110%攻击力的线上小兵。\n在卑尔维斯消耗【虚空珊瑚】时施加的减速会不断提升至99%。\n被动部分对史诗级野怪最大造成(【16/32/48】【随等级提升】+24%【额外攻击力】)真实伤害。\n在真实形态下，消耗【虚空珊瑚】会重新开始这个形态的持续时间并回复【100/250/400】生命值。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/BelvethR.png","abilityVideoPath":"champion-abilities/0200/ability_0200_R1.webm","dynamicDescription":"卑尔维斯消耗【虚空珊瑚残片】，转化为她的真实形态并提升她的最大生命值、攻击距离、和攻击速度。消耗来自虚空史诗级野怪的【虚空珊瑚残片】将为她提供召唤【虚空鱼】的能量。","cost":"0/0/0","costburn":"0/0/0","cooldown":"1/1/1","cooldownburn":"1/1/1","range":"450/450/450","cooldownupgrade":"1","costupgrade":"0"},{"heroId":"200","spellKey":"w","name":"上觐沉渊","description":"卑尔维斯甩尾重击，对敌人们造成(【80/140/200/260/320】+150%【额外法术强度】)魔法伤害、（【0.6/0.7/0.8/0.9/1】）秒击飞和持续2秒的30%减速。如果这个技能击中了一名敌方英雄，则刷新该英雄所在方向的虚空激流的冷却时间。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/BelvethW.png","abilityVideoPath":"champion-abilities/0200/ability_0200_W1.webm","dynamicDescription":"卑尔维斯甩尾重击，对命中的敌人造成伤害、击飞和减速。","cost":"0/0/0/0/0","costburn":"0/0/0/0/0","cooldown":"12/11/10/9/8","cooldownburn":"12/11/10/9/8","range":"715/715/715/715/715","cooldownupgrade":"12/11/10/9/8","costupgrade":"0"}],"version":"16.19","fileName":"200.js","fileTime":"2026-09-28 17:30:56"}