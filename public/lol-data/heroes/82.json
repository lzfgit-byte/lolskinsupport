.cn/images/lol/act/img/skinloading/82/a09734b8-e657-4b93-a86c-4f2245303cff.png","centerImg":"","instanceId":"a09734b8-e657-4b93-a86c-4f2245303cff"}],"spells":[{"heroId":"82","spellKey":"e","name":"断魂一扼","description":"主动：将敌人拉往他的方向，并造成(【60/80/100/120/140】 +45%【法术强度】)魔法伤害。\n百分比法术穿透：【5%/7.5%/10%/12.5%/15%】","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/MordekaiserE.png","abilityVideoPath":"champion-abilities/0082/ability_0082_E1.webm","dynamicDescription":"莫德凯撒拉拽一个区域内的所有敌人","cost":"0/0/0/0/0","costburn":"0/0/0/0/0","cooldown":"16/14/12/10/8","cooldownburn":"16/14/12/10/8","range":"700/700/700/700/700","cooldownupgrade":"16/14/12/10/8","costupgrade":"0"},{"heroId":"82","spellKey":"passive","name":"黑暗起兮","description":"莫德凯撒的攻击会造成额外的(40%【法术强度】)魔法伤害\n在用3次普通技能或攻击命中英雄或野怪后，莫德凯撒会将自身笼罩在负能量的遮蔽中。这个遮蔽每秒造成(5 +30%【法术强度】)加上(1-5【随等级提升】)%最大生命值的魔法伤害并为他提供(3% - 9%【随等级提升】)移动速度。\n伤害光环和移动速度持续4秒并在用技能或攻击命中一名英雄或野怪时刷新。\n这个技能每秒最多对野怪造成40伤害。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/MordekaiserPassive.MordeVGU.png","abilityVideoPath":"champion-abilities/0082/ability_0082_P1.webm","dynamicDescription":"莫德凯撒在对英雄或野怪打出3次攻击或技能之后获得一个强力的伤害光环和移动速度。","cost":"","costburn":"","cooldown":"","cooldownburn":"","range":"","cooldownupgrade":"","costupgrade":""},{"heroId":"82","spellKey":"q","name":"破灭之锤","description":"莫德凯撒用夜陨猛砸地面，造成(【80/115/150/185/220】+(0-45)【随等级提升】 +120%【额外攻击力】+70%【法术强度】)魔法伤害，如果这个技能只命中了一个敌人，则伤害提升至(【104/155.25/210/268.25/330】 +0-【58/61/63/65/68】【随等级提升】+【156%/162%/168%/174%/180%】【额外攻击力】+【91%/94.5%/98%/101.5%/105%】【法术强度】)\n孤立无援伤害【130%/135%/140%/145%/150%】","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/MordekaiserQ.png","abilityVideoPath":"champion-abilities/0082/ability_0082_Q1.webm","dynamicDescription":"莫德凯撒用他的权杖猛砸地面，来对被击中的每个敌人造成伤害。在只命中单个敌人时，伤害会提升。","cost":"0/0/0/0/0","costburn":"0/0/0/0/0","cooldown":"8/7/6/5/4","cooldownburn":"8/7/6/5/4","range":"675/675/675/675/675","cooldownupgrade":"8/7/6/5/4","costupgrade":"0"},{"heroId":"82","spellKey":"r","name":"轮回绝境","description":"莫德凯撒将自身和一个敌方英雄放逐至死者领域7秒，并在期间内偷取该英雄10%的核心属性。\n如果莫德凯撒在死者领域击杀了该敌人，那么他会吞噬目标的灵魂，保留他所偷取的属性，直到目标复活为止。\n已偷取的核心属性包括：法术强度，攻击力，攻击速度，护甲，魔法抗性和最大生命值。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/MordekaiserR.png","abilityVideoPath":"champion-abilities/0082/ability_0082_R1.webm","dynamicDescription":"莫德凯撒将自身和他的目标拖拽到一个异次元空间，并偷取目标的一部分属性。如果他击杀了目标，那么会将这些属性保持到目标复活。","cost":"0/0/0","costburn":"0/0/0","cooldown":"140/120/100","cooldownburn":"140/120/100","range":"650/650/650","cooldownupgrade":"140/120/100","costupgrade":"0"},{"heroId":"82","spellKey":"w","name":"不坏之身","description":"被动：莫德凯撒将他造成的45%伤害和他受到的7.5%伤害储存起来。\n主动：莫德凯撒获得相当于已储存伤害值的护盾。他可以再次施放这个技能来回复相当于【35%/37.5%/40%/42.5%/45%】剩余护盾值的生命值。\n最小护盾值：(5%【生命值】)\n最大护盾值：(30%【生命值】)\n护盾值会持续衰减。\n非英雄伤害的储存率会减少75%。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/MordekaiserW.png","abilityVideoPath":"champion-abilities/0082/ability_0082_W1.webm","dynamicDescription":"莫德凯撒将他所造成和承受的伤害储存起来，以创造一个护盾。他可以消耗这个护盾来治疗自身。","cost":"0/0/0/0/0","costburn":"0/0/0/0/0","cooldown":"12/11/10/9/8","cooldownburn":"12/11/10/9/8","range":"25000/25000/25000/25000/25000","cooldownupgrade":"12/11/10/9/8","costupgrade":"0"}],"version":"16.19","fileName":"82.js","fileTime":"2026-09-28 17:30:50"}