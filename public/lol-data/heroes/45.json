y":"q","name":"黑暗祭祀","description":"维迦释放一束黑暗能量，对命中的头2个敌人造成(【80/120/160/200/240】 +【50%/55%/60%/65%/70%】【法术强度】)魔法伤害。\n用此技能击杀一个单位，还会为维迦提供1层超凡邪恶效果。大型小兵和大型野怪会提供3层作为替代。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/VeigarBalefulStrike.png","abilityVideoPath":"champion-abilities/0045/ability_0045_Q1.webm","dynamicDescription":"维迦释放一束黑暗能量，对最先被命中的两个敌人造成魔法伤害。被这个能量束所击杀的单位，会永久地为维迦提供一些法术强度。","cost":"30/35/40/45/50","costburn":"30/35/40/45/50","cooldown":"6/5.5/5/4.5/4","cooldownburn":"6/5.5/5/4.5/4","range":"1000/1000/1000/1000/1000","cooldownupgrade":"6/5.5/5/4.5/4","costupgrade":"30/35/40/45/50"},{"heroId":"45","spellKey":"r","name":"能量爆裂","description":"维迦用源力魔法引爆目标一名敌方英雄，造成(【175/250/325】 +【65%/70%/75%】【法术强度】)到(【350/500/650】+【130%/140%/150%】【法术强度】)魔法伤害，伤害提升幅度基于目标的已损失生命值。目标生命值在33%以下即可造成最大伤害。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/VeigarR.png","abilityVideoPath":"champion-abilities/0045/ability_0045_R1.webm","dynamicDescription":"引爆目标敌方英雄，造成大量魔法伤害，并基于目标已损失生命值提升伤害。","cost":"100/100/100","costburn":"100/100/100","cooldown":"120/90/60","cooldownburn":"120/90/60","range":"650/650/650","cooldownupgrade":"120/90/60","costupgrade":"100"},{"heroId":"45","spellKey":"w","name":"黑暗物质","description":"维迦召唤黑暗物质将从天而降，造成(【85/140/195/250/305】 +【70%/80%/90%/100%/110%】【法术强度】)魔法伤害。\n每50层超凡邪力会使这个技能的冷却时间减少10%。\n冷却时间当前已减少0%。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/VeigarDarkMatter.png","abilityVideoPath":"champion-abilities/0045/ability_0045_W1.webm","dynamicDescription":"维迦召唤一大团黑暗物质轰击目标区域，落地造成魔法伤害。【超凡邪力】的层数会缩短这个技能的冷却时间。","cost":"60/65/70/75/80","costburn":"60/65/70/75/80","cooldown":"0/0/0/0/0","cooldownburn":"0/0/0/0/0","range":"950/950/950/950/950","cooldownupgrade":"0","costupgrade":"60/65/70/75/80"}],"version":"16.19","fileName":"45.js","fileTime":"2026-09-28 17:30:47"}