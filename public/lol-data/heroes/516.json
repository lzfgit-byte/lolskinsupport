lishTime":"","chromaImg":"https://game.gtimg.cn/images/lol/act/img/skinloading/516/6cd995c8-b73b-431b-8624-1b2c65c246b8.png","centerImg":"","instanceId":"6cd995c8-b73b-431b-8624-1b2c65c246b8"},{"skinId":"516037","heroId":"516","heroName":"山隐之焰","heroTitle":"奥恩","name":"神盾机甲 奥恩 冥神铁翼","chromas":"1","chromasBelongId":"516029","isBase":"0","emblemsName":"","description":"","mainImg":"","iconImg":"","loadingImg":"","videoImg":"","sourceImg":"","vedioPath":"","suitType":"","publishTime":"","chromaImg":"https://game.gtimg.cn/images/lol/act/img/skinloading/516/be5001b2-49b7-4b4b-95f8-643cdaf8ced4.png","centerImg":"","instanceId":"be5001b2-49b7-4b4b-95f8-643cdaf8ced4"}],"spells":[{"heroId":"516","spellKey":"e","name":"炽烈冲锋","description":"奥恩冲锋，造成(【80/125/170/215/260】+40%【额外护甲】+40%【额外魔法抗性】)物理伤害。如果奥恩撞到了地形，则会引发冲击波，击飞敌人1.25秒并将此技能的伤害施加给那些未被冲锋命中的敌人们。\n奥恩的冲锋会摧毁熔岩之柱和由敌方英雄创造的地形。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/OrnnE.png","abilityVideoPath":"champion-abilities/0516/ability_0516_E1.webm","dynamicDescription":"奥恩冲锋，对他途经的敌人造成伤害。如果奥恩在冲锋状态下与地形产生碰撞，那么这次碰撞就会在他四周生成一道冲击波，来对敌人造成伤害和击飞效果。","cost":"35/40/45/50/55","costburn":"35/40/45/50/55","cooldown":"14/13.5/13/12.5/12","cooldownburn":"14/13.5/13/12.5/12","range":"450/450/450/450/450","cooldownupgrade":"14/13.5/13/12.5/12","costupgrade":"35/40/45/50/55"},{"heroId":"516","spellKey":"passive","name":"活体锻炉","description":"奥恩可在地图的任意位置上花费金钱来锻造非消耗品的装备。\n当奥恩到达13级时，他将能把自己的一件传说装备升级成一件杰作装备。13级后，每升1级，奥恩就可为一名友方升级一件传说装备，方法是彼此处在附近时点击该友方英雄。\n奥恩使所有来源的生命值、护甲和魔抗加成额外提升10%。奥恩每给一件传说装备进行升级，就会使这些加成属性提升4%。\n一个英雄仅能拥有一件杰作装备。\n奥恩可以直接从他的熔炉菜单或商店中打造装备。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/passive/OrnnP.png","abilityVideoPath":"champion-abilities/0516/ability_0516_P1.webm","dynamicDescription":"奥恩可使所有来源的护甲和魔抗加成获得额外提升。<br><br>奥恩可在地图的任意位置上花费金钱来锻造非消耗品的装备。<br><br>此外，他能为他自己和友方英雄打造杰作武器。","cost":"","costburn":"","cooldown":"","cooldownburn":"","range":"","cooldownupgrade":"","costupgrade":""},{"heroId":"516","spellKey":"q","name":"火山突堑","description":"奥恩猛砸地面，创造一道裂隙来造成(【20/45/70/95/120】+110%【攻击力】)物理伤害，以及持续2秒的40%减速。一根熔岩之柱会在裂隙的终点处形成，持续4秒。\n裂隙在命中一名敌方英雄后会短暂地停滞。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/OrnnQ.png","abilityVideoPath":"champion-abilities/0516/ability_0516_Q1.webm","dynamicDescription":"奥恩猛砸地面，形成一道裂隙来伤害并减速被击中的敌人们。在一阵短暂的延迟后，一个熔岩之柱会在裂隙的终点处形成。","cost":"45/45/45/45/45","costburn":"45/45/45/45/45","cooldown":"9/8.5/8/7.5/7","cooldownburn":"9/8.5/8/7.5/7","range":"800/800/800/800/800","cooldownupgrade":"9/8.5/8/7.5/7","costupgrade":"45"},{"heroId":"516","spellKey":"r","name":"熔铸之神的召唤","description":"奥恩召唤一个巨大的岩浆元素来疾奔向他，造成(【125/175/225】+20%【法术强度】)魔法伤害，对命中\n的敌人们施加持续3秒的易碎和【40%/50%/60%】减速。\n奥恩可以再次施放这个技能来用头槌进行冲刺。如果他冲刺到了岩浆元素，那么他可以使它重新导向并强化它，使它击飞首个命中的敌方英雄1秒和后续的英雄们0.5秒。岩浆元素还会造成(【125/175/225】+20%【法术强度】)魔法伤害并施加易碎。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/OrnnR.png","abilityVideoPath":"champion-abilities/0516/ability_0516_R1.webm","dynamicDescription":"奥恩在目标位置召唤一个巨大的岩浆元素，岩浆元素会以逐渐提升的速度跑向奥恩。被岩浆元素途经的敌人会受到伤害、减速效果并被施加易碎效果。奥恩可以再次施放这个技能，以冲向岩浆元素，并在命中岩浆元素时重新导向岩浆元素，使岩浆元素可将途经的任何敌人击飞，造成等额的伤害并再次施加易碎效果。","cost":"100/100/100","costburn":"100/100/100","cooldown":"140/120/100","cooldownburn":"140/120/100","range":"2500/2500/2500","cooldownupgrade":"140/120/100","costupgrade":"100"},{"heroId":"516","spellKey":"w","name":"风箱炎息","description":"奥恩向前不可阻挡地重踏，同时喷吐炎息，在0.75秒里持续造成共【12%/13%/14%/15%/16%】最大生命值的魔法伤害。被最后一道炎息命中的敌人，会变成易碎效果，持续3秒。\n对易碎状态的敌人施加的下一个定身效果将使该效果的持续时间提升30%并对目标造成额外的(9.0%-17.0%【随等级提升】)最大生命值的魔法伤害。奥恩的普攻会击退易碎状态下的目标，并造成额外伤害。\n对英雄和小兵最少造成80魔法伤害，对野怪最多造成260魔法伤害。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/OrnnW.png","abilityVideoPath":"champion-abilities/0516/ability_0516_W1.webm","dynamicDescription":"奥恩向前进发，喷出炎息。被最后一阵炎息命中的敌人将变为易碎状态。","cost":"45/50/55/60/65","costburn":"45/50/55/60/65","cooldown":"12/11.5/11/10.5/10","cooldownburn":"12/11.5/11/10.5/10","range":"25000/25000/25000/25000/25000","cooldownupgrade":"12/11.5/11/10.5/10","costupgrade":"45/50/55/60/65"}],"version":"16.19","fileName":"516.js","fileTime":"2026-09-28 17:30:59"}