"","iconImg":"","loadingImg":"","videoImg":"","sourceImg":"","vedioPath":"","suitType":"","publishTime":"","chromaImg":"https://game.gtimg.cn/images/lol/act/img/skinloading/910/9333a945-829b-40fc-97b0-bf766b448f58.png","centerImg":"","instanceId":"9333a945-829b-40fc-97b0-bf766b448f58"},{"skinId":"910020","heroId":"910","heroName":"异画师","heroTitle":"彗","name":"灵魂莲华 彗 至强","chromas":"1","chromasBelongId":"910011","isBase":"0","emblemsName":"","description":"","mainImg":"","iconImg":"","loadingImg":"","videoImg":"","sourceImg":"","vedioPath":"","suitType":"","publishTime":"","chromaImg":"https://game.gtimg.cn/images/lol/act/img/skinloading/910/f477947e-92f4-40f7-9bd2-a80f22f76559.png","centerImg":"","instanceId":"f477947e-92f4-40f7-9bd2-a80f22f76559"},{"skinId":"910021","heroId":"910","heroName":"异画师","heroTitle":"彗","name":"恶魔假日 彗","chromas":"0","chromasBelongId":"0","isBase":"0","emblemsName":"common","description":"虽然通常都待在冥界深处，但彗却被“劝说”前去尝试一下在沙滩上沉思。看着凡人们在大白天四散奔逃，确实激发了用于极乐折磨的新点子。当海滩游客们以为在太阳下很安全时，彗却用乌黑的云朵和汹涌的海浪将其遮蔽，彻底浇灭了他们的好心情。","mainImg":"https://game.gtimg.cn/images/lol/act/img/skin/big_12e02271-2e62-48a7-b0af-eb2b8a53db7f.jpg","iconImg":"https://game.gtimg.cn/images/lol/act/img/skin/small_12e02271-2e62-48a7-b0af-eb2b8a53db7f.jpg","loadingImg":"https://game.gtimg.cn/images/lol/act/img/skinloading/12e02271-2e62-48a7-b0af-eb2b8a53db7f.jpg","videoImg":"https://game.gtimg.cn/images/lol/act/img/skinvideo/sp_12e02271-2e62-48a7-b0af-eb2b8a53db7f.jpg","sourceImg":"https://game.gtimg.cn/images/lol/act/img/guidetop/guide_12e02271-2e62-48a7-b0af-eb2b8a53db7f.jpg","vedioPath":"","suitType":"230","publishTime":"","chromaImg":"","centerImg":"https://game.gtimg.cn/images/lol/act/img/center/12e02271-2e62-48a7-b0af-eb2b8a53db7f.jpg","instanceId":"12e02271-2e62-48a7-b0af-eb2b8a53db7f"}],"spells":[{"heroId":"910","spellKey":"e","name":"主题：悚","description":"彗描绘出恐怖景象来控制敌人们。\n阴沉变意\n彗在人心中投下恐怖的阴影，使命中的第一个敌人逃跑1秒并造成(【70/110/150/190/230】 +65%【法术强度】)魔法伤害。\n滞涩幽瞳\n彗在目标位置画出一枚提供视野的深邃眼眸，它会锁定相距最近的那个敌方英雄并对其发射一颗追踪飞弹，这颗飞弹会对命中的第一个敌人造成【1.2/1.4/1.6/1.8/2秒】禁锢和(【70/110/150/190/230】+65%【法术强度】)魔法伤害。\n双钩血喉\n彗画出一张大口，对命中的敌人们造成(【70/110/150/190/230】+65%【法术强度】)魔法伤害，并将其拖拽向中心，造成在1.25秒内持续衰减的【40%/47.5%/55%/62.5%/70%】减速。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/HweiE.png","abilityVideoPath":"champion-abilities/0910/ability_0910_E1.webm","dynamicDescription":"彗将眼中所见到的恐怖景象付诸笔端，带来震慑人心的画面。<br><br>这个技能会用这些控制型技能替换掉彗的技能：阴沉变意、滞涩幽瞳、双钩血喉。","cost":"50/55/60/65/70","costburn":"50/55/60/65/70","cooldown":"12/11.5/11/10.5/10","cooldownburn":"12/11.5/11/10.5/10","range":"0/0/0/0/0","cooldownupgrade":"12/11.5/11/10.5/10","costupgrade":"50/55/60/65/70"},{"heroId":"910","spellKey":"passive","name":"落款","description":"彗的伤害型技能会对敌方英雄施加持续4秒的标记。\n用第二个伤害型技能命中被标记的敌人，即可在其脚下生成一次爆炸，对范围内的所有敌人造成(40-285【随等级提升】 +35%【法术强度】)魔法伤害。\n每个技能仅会对每个目标触发一次这个效果。\n彗的各个技能施加的不同减速彼此之间会以一个不断递减的比率来叠加(但不与装备或其它来源叠加)。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/passive/HweiPassive.png","abilityVideoPath":"champion-abilities/0910/ability_0910_P1.webm","dynamicDescription":"彗准备在那些受到他的技能伤害的敌人们身上留下落款。<br><br>用另一个伤害型技能命中时，即可完成他的落款，将其留在敌人脚下。落款会在短暂延迟后引爆，对范围内的所有敌人造成魔法伤害。","cost":"","costburn":"","cooldown":"","cooldownburn":"","range":"","cooldownupgrade":"","costupgrade":""},{"heroId":"910","spellKey":"q","name":"主题：灾","description":"彗描绘出眼中所见的灾难，来对敌人们造成大量伤害。\n没骨火\n彗画出一发炽热的火球，飞向目标方向。火球在命中第一个敌人时爆炸，对区域内的所有敌人造成(【50/80/110/140/170】+80%【法术强度】)外加【3%/4%/5%/6%/7%】最大生命值的魔法伤害。\n攒聚雷\n在一段延迟后，彗在目标位置降下一道强大的远距离落雷，造成(【60/85/110/135/160】+30%【法术强度】)魔法伤害。孤立无援或定身的敌人将基于已损失生命值受到额外伤害，至多至【120/201.875/302.5/421.875/560】+【60%/71.25%/82.5%/93.75%/105%】【法术强度】魔法伤害。\n连皴山\n彗画出一道不断爆裂的岩浆喷发地带，所过之处岩浆翻滚。每次爆裂都会对命中的敌人们造成(【20/35/50/65/80】 +30%【法术强度】)魔法伤害。位于岩浆区域内的敌人每秒承受(【20/35/50/65/80】+24%【法术强度】)魔法伤害，并被减速35%。每个岩浆池持续2.5秒。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/HweiQ.png","abilityVideoPath":"champion-abilities/0910/ability_0910_Q1.webm","dynamicDescription":"彗将眼中所见的灾难逐一描绘，造成可怕的破坏力。<br><br>这个技能会用这些伤害型技能替换掉彗的技能：没骨火、攒聚雷、连皴山。","cost":"80/90/100/110/120","costburn":"80/90/100/110/120","cooldown":"10/9/8/7/6","cooldownburn":"10/9/8/7/6","range":"0/0/0/0/0","cooldownupgrade":"10/9/8/7/6","costupgrade":"80/90/100/110/120"},{"heroId":"910","spellKey":"r","name":"焚心绚华绘","description":"彗将深重的绝望附着在一名敌方英雄上，持续3秒。绝望会持续扩大，每0.25秒对敌人\n们施加一层可叠加的10%减速，并造成每秒(【10/20/30】 +5%【法术强度】)魔法伤害\n在完成的同时，绝望会碎裂，造成(【200/325/450】+80%【法术强度】)魔法伤害。\n可能的最大伤害为(【230/385/540】 +95%【法术强度】)魔法伤害。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/HweiR.png","abilityVideoPath":"champion-abilities/0910/ability_0910_R1.webm","dynamicDescription":"彗画出深重的绝望。命中的第一个敌人会成为画卷的中心。画卷向四周展开，减速并伤害附近的敌人们。展开至最大时，或是中心的敌人死亡时，画卷会发生爆炸。","cost":"100/100/100","costburn":"100/100/100","cooldown":"120/100/80","cooldownburn":"120/100/80","range":"1300/1300/1300","cooldownupgrade":"120/100/80","costupgrade":"100"},{"heroId":"910","spellKey":"w","name":"主题：靖","description":"彗画下眼中所见到的宁静来为他和友方英雄们提供功能性。\n飞染\n彗画出一条持续【4/4.5/5/5.5/6秒】的激流，为自己和友方英雄们提供(【30%/32.5%/35%/37.5%/40%】+0.03%【法术强度】)移动速度。\n渲浓\n彗在目标位置画下一汪持续3秒的池水，为位于范围内的队友立刻提供(【50/70/90/110/130】+30%【法术强度】)护盾值，且这个护盾值会在3秒里持续提升至(【100/145/180/231/260】 +60%)护盾值并且对友军时减少15%护盾值。\n宿墨\n彗在身边点出三团光芒，来使他的下三次技能或攻击造成额外的(【20/30/40/50/60】 +15%)魔法伤害并附带回复65法力","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/HweiW.png","abilityVideoPath":"champion-abilities/0910/ability_0910_W1.webm","dynamicDescription":"彗画下眼中所见到的宁静，抚慰并激励众人。<br><br>这个技能会用这些功能型技能替换掉彗的技能：飞染、渲浓、宿墨","cost":"90/95/100/105/110","costburn":"90/95/100/105/110","cooldown":"18/17.5/17/16.5/16","cooldownburn":"18/17.5/17/16.5/16","range":"0/0/0/0/0","cooldownupgrade":"18/17.5/17/16.5/16","costupgrade":"90/95/100/105/110"}],"version":"16.19","fileName":"910.js","fileTime":"2026-09-28 17:31:01"}