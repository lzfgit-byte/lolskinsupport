pg","sourceImg":"https://game.gtimg.cn/images/lol/act/img/guidetop/guide_8c397c58-4090-4bdb-ab1b-f45343f85442.jpg","vedioPath":"","suitType":"143","publishTime":"","chromaImg":"","centerImg":"https://game.gtimg.cn/images/lol/act/img/center/8c397c58-4090-4bdb-ab1b-f45343f85442.jpg","instanceId":"8c397c58-4090-4bdb-ab1b-f45343f85442"}],"spells":[{"heroId":"518","spellKey":"e","name":"缠结倒刺","description":"妮蔻掷出一团倒刺，造成(【70/105/140/175/210】+65%【法术强度】)魔法伤害和【0.7/0.9/1.1/1.3/1.5】秒的禁锢效果。\n倒刺会在命中一名敌方英雄后强化，长得更大、动得更快、并且禁锢时长变为【1.8/2.1/2.4/2.7/3】秒。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/NeekoE.png","abilityVideoPath":"champion-abilities/0518/ability_0518_E1.webm","dynamicDescription":"妮蔻投出一团倒刺，对它沿途的所有东西造成伤害和禁锢效果。如果倒刺击杀了一个敌人或穿过了一名英雄，就会变得更大、更快并且禁锢时间更长。","cost":"60/65/70/75/80","costburn":"60/65/70/75/80","cooldown":"12/11.5/11/10.5/10","cooldownburn":"12/11.5/11/10.5/10","range":"1000/1000/1000/1000/1000","cooldownupgrade":"12/11.5/11/10.5/10","costupgrade":"60/65/70/75/80"},{"heroId":"518","spellKey":"passive","name":"天生幻魅","description":"妮蔻可以将自身假扮成地图上的其它单位。她在任何时候都可以假扮成一名友方英雄;在她紧挨着任何友方或中立单位时，她会储存其烁玛并使她能够假扮成该单位。你的假扮状态将在以下情况被打破：受到定身类控制效果、施放一个伤害型的技能、假扮非英雄单位时对敌方防御塔造成伤害、或者受到了与假扮对象生命条相等的伤害。妮蔻会获得她假扮单位的很多属性，包括有益和有害的。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/Neeko_P.png","abilityVideoPath":"champion-abilities/0518/ability_0518_P1.webm","dynamicDescription":"妮蔻可以假扮成一名友方英雄或地图上的其它单位。承受定身类限制效果、施放伤害型的技能、以非英雄单位的状态对敌方防御塔造成伤害、或者你的假扮受到了相当于其生命条的伤害时，都会打破这个假扮状态。","cost":"","costburn":"","cooldown":"","cooldownburn":"","range":"","cooldownupgrade":"","costupgrade":""},{"heroId":"518","spellKey":"q","name":"盛开花种","description":"妮蔻扔出一颗种子以造成(【60/110/160/210/260】+60%【法术强度】)魔法伤害。如果种子击杀了一个单位或命中了一个英雄或大型野怪，那么它会再次盛开，造成(【35/60/85/110/135】+25%【法术强度】)魔法伤害。最多可额外盛开2次。\n每次绽放对野怪造成额外的【35/50/65/80/95】魔法伤害。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/NeekoQ.png","abilityVideoPath":"champion-abilities/0518/ability_0518_Q1.webm","dynamicDescription":"妮蔻扔出一颗种子以造成伤害。种子在再次命中英雄或击杀单位时会盛开。","cost":"50/60/70/80/90","costburn":"50/60/70/80/90","cooldown":"9/8.5/8/7.5/7","cooldownburn":"9/8.5/8/7.5/7","range":"800/800/800/800/800","cooldownupgrade":"9/8.5/8/7.5/7","costupgrade":"50/60/70/80/90"},{"heroId":"518","spellKey":"r","name":"怒放","description":"在短暂延迟后，妮蔻会跃入空中，对所有附近的敌人造成0.6秒击飞。然后她会猛然着陆，对附近的所有敌人造成(【150/350/550】+120%【法术强度】)魔法伤害和0.75秒晕眩效果。\n如果妮蔻处于假扮状态时，那么这个技能的准备阶段不会被敌人看见。妮蔻会在施放这个技能的0.5秒后打破她的假扮状态。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/NeekoR.png","abilityVideoPath":"champion-abilities/0518/ability_0518_R1.webm","dynamicDescription":"在短暂的准备阶段后，妮蔻会跃入空中，击飞所有附近的英雄。在着陆时，附近的敌人会受到伤害并被晕眩。如果妮蔻处于假扮状态时，那么准备阶段不会被敌人看见。","cost":"100/100/100","costburn":"100/100/100","cooldown":"120/105/90","cooldownburn":"120/105/90","range":"600/600/600","cooldownupgrade":"120/105/90","costupgrade":"100"},{"heroId":"518","spellKey":"w","name":"两生花影","description":"被动：每第三次攻击造成(【30/65/100/135/170】+60%【法术强度】)额外魔法伤害并使妮蔻获得持续1秒的【10%/17.5%/25%/32.5%/40%】移动速度提升。\n主动：妮蔻隐形0.5秒并投射出一个持续3秒的复制体。妮蔻和复制体会获得持续3秒的【20%/25%/30%/35%/40%】移动速度。\n可通过使用“移动宠物点击”热键或通过再次施放这个技能来控制复制体。\n复制体会镜像模仿她的技能施放、表情和回城。\n复制体在潜行时是不可被选取的。\n强化攻击对野怪造成75额外魔法伤害。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/NeekoW.png","abilityVideoPath":"champion-abilities/0518/ability_0518_W1.webm","dynamicDescription":"被动效果：妮蔻每第三次攻击造成额外魔法伤害，并短暂提升她的移动速度。主动效果：妮蔻能够朝一个方向投射出一个幻像并通过再次施放来改变幻象的方向。","cost":"0/0/0/0/0","costburn":"0/0/0/0/0","cooldown":"16/15/14/13/12","cooldownburn":"16/15/14/13/12","range":"900/900/900/900/900","cooldownupgrade":"16/15/14/13/12","costupgrade":"0"}],"version":"16.19","fileName":"518.js","fileTime":"2026-09-28 17:31:00"}