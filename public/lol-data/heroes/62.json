ostupgrade":"100"},{"heroId":"62","spellKey":"w","name":"真假猴王","description":"孙悟空突进并变为隐形状态，持续1秒，同时留下一个持续4秒的不能移动的分身。\n分身会攻击附近的近期被孙悟空造成过伤害的敌人并会模拟他的终极技能，造成【40%/45%/50%/55%/60%】的常规伤害。\n隐形单位只会被【防御塔】或【真实视野】显形。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/MonkeyKingDecoy.png","abilityVideoPath":"champion-abilities/0062/ability_0062_W1.webm","dynamicDescription":"孙悟空变为隐形状态并朝着一个方向突进，同时留下一个会攻击附近敌人的分身。","cost":"40/45/50/55/60","costburn":"40/45/50/55/60","cooldown":"22/21/20/19/18","cooldownburn":"22/21/20/19/18","range":"275/275/275/275/275","cooldownupgrade":"22/21/20/19/18","costupgrade":"60/55/50/45/40"}],"version":"16.19","fileName":"62.js","fileTime":"2026-09-28 17:30:49"}