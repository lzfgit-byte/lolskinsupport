down":"130/115/100","cooldownburn":"130/115/100","range":"1000/1000/1000","cooldownupgrade":"130/115/100","costupgrade":"100"},{"heroId":"54","spellKey":"w","name":"雷霆拍击","description":"被动：墨菲特获得【10%/15%/20%/25%/30%】护甲。这个效果会在花岗岩护盾激活时提升至30%\n主动：墨菲特的下次攻击造成额外的(【30/40/50/60/70 】+20%【法术强度】+15%【护甲】)物理伤害攻击特效，并会引发一阵余震，以在一个锥形范围内造成(【15/25/35/45/55】+30%【法术强度】+15%【护甲】)物理伤害【攻击速度】攻击特效。在接下来的5秒内，他的攻击会继续引发余震攻击特效。\n对野怪造成180%伤害。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/Obduracy.png","abilityVideoPath":"champion-abilities/0054/ability_0054_W1.webm","dynamicDescription":"墨菲特的攻击蕴含着如此惊人的力道以至于它引发了一次音爆。在接下来的数秒里，他的攻击会在他面前引发余波。","cost":"30/35/40/45/50","costburn":"30/35/40/45/50","cooldown":"10/9.5/9/8.5/8","cooldownburn":"10/9.5/9/8.5/8","range":"400/400/400/400/400","cooldownupgrade":"10/9.5/9/8.5/8","costupgrade":"30/35/40/45/50"}],"version":"16.19","fileName":"54.js","fileTime":"2026-09-28 17:30:48"}