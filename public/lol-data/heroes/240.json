"loadingImg":"","videoImg":"","sourceImg":"","vedioPath":"","suitType":"","publishTime":"","chromaImg":"https://game.gtimg.cn/images/lol/act/img/skinloading/240/34606a3f-0052-4f3d-97b1-e58b327bca77.png","centerImg":"","instanceId":"34606a3f-0052-4f3d-97b1-e58b327bca77"},{"skinId":"240026","heroId":"240","heroName":"暴怒骑士","heroTitle":"克烈","name":"狗粮克烈 吃了更伶俐！","chromas":"1","chromasBelongId":"240018","isBase":"0","emblemsName":"","description":"","mainImg":"","iconImg":"","loadingImg":"","videoImg":"","sourceImg":"","vedioPath":"","suitType":"","publishTime":"","chromaImg":"https://game.gtimg.cn/images/lol/act/img/skinloading/240/ad3629ab-31e1-4282-8e4e-49326429ee78.png","centerImg":"","instanceId":"ad3629ab-31e1-4282-8e4e-49326429ee78"}],"spells":[{"heroId":"240","spellKey":"e","name":"比武","description":"克烈进行冲刺，对途经的敌人们造成(【35/60/85/110/135】 +55% 【额外攻击力】)物理伤害，同时将小兵和小型野怪拉向他。\n如果这个技能命中了一名敌方英雄或大型野怪，那么克烈会获得持续1秒的50%移动速度并能在3秒内再次施放这个技能来冲刺并穿过相同目标。\n克烈会获得途经敌人们的真实视野。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/KledE.png","abilityVideoPath":"champion-abilities/0240/ability_0240_E1.webm","dynamicDescription":"克烈发起突进，造成物理伤害并短暂获得爆发性移速加成。克烈可以再次施放这个技能来回身突进，穿过初始目标，同时造成等额伤害。","cost":"0/0/0/0/0","costburn":"0/0/0/0/0","cooldown":"13/12/11/10/9","cooldownburn":"13/12/11/10/9","range":"550/550/550/550/550","cooldownupgrade":"13/12/11/10/9","costupgrade":"0"},{"heroId":"240","spellKey":"passive","name":"怯战蜥蜴斯嘎尔","description":"骑乘状态：克烈的坐骑斯嘎尔会代替克烈承受伤害。当斯嘎尔的生命值耗尽时，克烈就会进入非骑乘状态。\n非骑乘状态：克烈替换掉飞索捕熊器，在朝着敌方英雄移动时会获得(70-155【随等级成长】)移动速度，并且他获得4+1%【额外生命值】额外护甲和魔法抗性，附近的每个敌方英雄都会使这个加成提升30%，至多至10+2.5%【额外生命值】。在非骑乘状态下，克烈的攻击对英雄造成的伤害降低(15%-0%【随等级成长】)\n克烈可通过攻击英雄来获得15勇气、攻击史诗级野怪和建筑物来获得5勇气、击杀小兵来获得5勇气。在满层勇气时，克烈会骑着(40%-70%【随等级成长】)生命值的斯嘎尔重回骑乘状态，每30秒一次\n斯嘎尔拥有(400-1400【随等级成长】)生命值外加克烈100%的额外生命值\n在克烈进入非骑乘状态的同时，他会净化掉所有控制效果并暂时变为不可被选取状态。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/passive/Kled_P.png","abilityVideoPath":"champion-abilities/0240/ability_0240_P1.webm","dynamicDescription":"克烈的可靠坐骑——斯嘎尔——会为他承受伤害。当斯嘎尔的生命值耗尽时，会导致克烈进入非骑乘状态。额外生命值属性只会施加给斯嘎尔。<br><br>在非骑乘状态下时，克烈会更换若干技能并对英雄造成较少伤害。克烈可通过与敌人作战来回复斯嘎尔的勇气。在勇气到达满值时，克烈会骑着拥有部分生命值的斯嘎尔重回骑乘状态。","cost":"","costburn":"","cooldown":"","cooldownburn":"","range":"","cooldownupgrade":"","costupgrade":""},{"heroId":"240","spellKey":"q","name":"飞索捕熊器","description":"骑乘状态：克烈扔出一个捕熊器来钩住第一个命中的敌方英雄或大型野怪并造成(【30/55/80/105/130】 +60% 【额外攻击力】)物理伤害。\n如果克烈在一名被钩住的敌人附近呆1.75秒，那么他就会将该敌人拽向他并造成(【60/110/160/210/260】 +120%【额外攻击力】)物理伤害，拉拽该敌人，造成持续2.5秒的【30%/35%/40%/45%/50%】减速。\n非骑乘状态：克烈发射一发霰弹枪，造成(【35/50/65/80/95】 +65% 【额外攻击力】)物理伤害并使克烈因后坐力而向后位移。第一颗之后的弹丸造成较少伤害。\n每颗弹丸在命中一名敌方英雄或史诗级野怪时都会回复勇气\n在钩住目标时，克烈拥有该敌人的真实视野。\n对小兵造成150%伤害","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/KledQ.png","abilityVideoPath":"champion-abilities/0240/ability_0240_Q1.webm","dynamicDescription":"克烈投掷一个捕熊器，钩住一个敌人并造成伤害。如果短时间内牵引没有被打破，那么目标会受到额外物理伤害并被拽向克烈。<br><br>当处于非骑乘状态下时，这个技能会被替换为【随身手枪】——一个远程枪击技能，可将克烈击退并回复勇气值。","cost":"0/0/0/0/0","costburn":"0/0/0/0/0","cooldown":"11/10/9/8/7","cooldownburn":"11/10/9/8/7","range":"800/800/800/800/800","cooldownupgrade":"11/10/9/8/7","costupgrade":"0"},{"heroId":"240","spellKey":"r","name":"冲啊——！！","description":"克烈冲向一个区域，留下一条路径，该路径可为友军们提供不断提升的移动速度。在开始冲锋后的2秒里，克烈会至多获得(【200/300/400】 +300% 【额外攻击力】 )护盾值。斯嘎尔会撞击遇到的首个敌方英雄，造成(【4%/6%/8%】 +0.03% 【额外攻击力】)到(【12%/18%/24%】 +0.09% 【额外攻击力】)最大生命值的魔法伤害(基于已移动的距离)和短暂的击退。\n伤害、移动速度和护盾值会在冲锋3秒后达到最大值。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/KledR.png","abilityVideoPath":"champion-abilities/0240/ability_0240_R1.webm","dynamicDescription":"克烈和斯嘎尔朝着一个位置发起冲锋，同时在身后留下一条提供加速效果的轨迹，并为自己构建一个护盾。斯嘎尔会在遭遇首个敌方英雄时将其锁定并发起撞击。","cost":"0/0/0","costburn":"0/0/0","cooldown":"140/125/110","cooldownburn":"140/125/110","range":"3500/4000/4500","cooldownupgrade":"140/125/110","costupgrade":"0"},{"heroId":"240","spellKey":"w","name":"暴烈秉性","description":"被动：克烈的下次攻击会提供150%攻击速度，持续4次攻击或4秒。\n第四击造成额外的【20/30/40/50/60】外加(【4.5%/5%/5.5%/6%/6.5%】 +0.02%【额外攻击力】+0.004%【额外生命值】 )最大生命值的物理伤害。\n对野怪的最大生命值伤害的封顶值为200物理伤害。\n在尚未冷却时，攻击会使这个技能的冷却时间缩减0.5秒。在对抗英雄时，这个冷却缩减提升至1.5秒。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/KledW.png","abilityVideoPath":"champion-abilities/0240/ability_0240_W1.webm","dynamicDescription":"克烈获得持续4次攻击的巨幅攻速加成。第四次攻击会造成更多伤害。","cost":"0/0/0/0/0","costburn":"0/0/0/0/0","cooldown":"13/12/11/10/9","cooldownburn":"13/12/11/10/9","range":"0/0/0/0/0","cooldownupgrade":"13/12/11/10/9","costupgrade":"0"}],"version":"16.19","fileName":"240.js","fileTime":"2026-09-28 17:30:58"}