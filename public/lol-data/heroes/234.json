,"chromaImg":"","centerImg":"https://game.gtimg.cn/images/lol/act/img/center/8b9d1eeb-55f9-4725-ad1f-659a1f2c33e0.jpg","instanceId":"8b9d1eeb-55f9-4725-ad1f-659a1f2c33e0"}],"spells":[{"heroId":"234","spellKey":"e","name":"茫茫焦土","description":"佛耶戈向前派出一个幽鬼去萦绕命中的第一个地形，用黑雾将其笼罩8秒。佛耶戈在黑雾中时会获得伪装，(【25%/27.5%/30%/32.5%/35%】+0.04%【法术强度】)移动速度，和【30%/35%/40%/45%/50%】攻击速度。\n伪装的单位不会被敌人看见，除非有一名敌方英雄在其侦测半径中。\n佛耶戈在攻击或使用任一技能时会显形0.6秒。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/ViegoE.png","abilityVideoPath":"champion-abilities/0234/ability_0234_E1.webm","dynamicDescription":"佛耶戈命令黑雾去萦绕并笼罩一块地形。佛耶戈可以如幽魂一般隐藏在黑雾中，获得【伪装】状态、移动速度和攻击速度。","cost":"0/0/0/0/0","costburn":"0/0/0/0/0","cooldown":"14/12/10/8/6","cooldownburn":"14/12/10/8/6","range":"750/750/750/750/750","cooldownupgrade":"14/12/10/8/6","costupgrade":"0"},{"heroId":"234","spellKey":"passive","name":"君命已决","description":"如果敌方英雄在被佛耶戈命中后的3秒内阵亡的话，就会变成幽魂。佛耶戈可以攻击幽魂来占据该英雄，回复该英雄(2+2.5%【额外攻击力】+2%【法术强度】+500%【额外攻击速度】+0.4%【额外生命值】)%的最大生命值并获得该英雄非终极技能、攻击和装备的使用权，持续10秒。在此期间，他会将该英雄的终极技能替换为他自己终极技能的一次免费施放，并在朝着敌方英雄时获得10%移动速度。\n在占据期间，佛耶戈会保留他的召唤师技能、符文和饰品，并且不能使用主动装备或消耗品。在占据期间，被动装备的冷却时间是共享的。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/ViegoP.png","abilityVideoPath":"champion-abilities/0234/ability_0234_P1.webm","dynamicDescription":"倒在佛耶戈面前的敌方英雄们会变为幽魂。通过攻击一个幽魂，佛耶戈可以暂时夺取该英雄躯体的控制权，获得相当于他目标一部分最大生命值的治疗效果并获得该英雄的基础技能和装备的使用权。他会将其终极技能替换为他自己终极技能的一次免费施放。","cost":"","costburn":"","cooldown":"","cooldownburn":"","range":"","cooldownupgrade":"","costupgrade":""},{"heroId":"234","spellKey":"q","name":"破败王剑","description":"被动：佛耶戈的攻击造成额外的【2%/3%/4%/5%/6%】当前生命值的物理伤害。如果敌人近期被他用一个技能伤害过，那么他对该敌人的第一次攻击会进行两次打击，造成(20%【攻击力】+15%【法术强度】)物理伤害并回复150%实际伤害值的生命值。这些被动加成会在占据期间保留。\n主动：佛耶戈向前戳刺，造成【25/40/55/70/85】(+70%【攻击力】)物理伤害。\n在未占据一名敌人时，第二次打击可以暴击并且可以施加【攻击特效】。它的治疗效果在对野怪时降低至125%并且对小兵时降低至100%。\n额外【攻击特效】伤害可以暴击造成3.4%当前生命值的伤害，并且最小值为10伤害。它对野怪的最大伤害值为80伤害。\n技能的施放时间可由攻击速度来缩短。它的伤害受益于暴击几率和暴击伤害，效能为60%。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/ViegoQ.png","abilityVideoPath":"champion-abilities/0234/ability_0234_Q1.webm","dynamicDescription":"佛耶戈的鬼魅之刃会在被动地在命中时造成额外的百分比当前生命值伤害<OnHit>攻击特效</OnHit>，并对近期被他用一个技能袭击过的敌人进行两次打击，同时窃取生命值。<br><br>佛耶戈可以激活这个技能来向前刺出他的双手巨剑，穿刺他前方的所有敌人们。","cost":"0/0/0/0/0","costburn":"0/0/0/0/0","cooldown":"5/4.5/4/3.5/3","cooldownburn":"5/4.5/4/3.5/3","range":"600/600/600/600/600","cooldownupgrade":"5/4.5/4/3.5/3","costupgrade":"0"},{"heroId":"234","spellKey":"r","name":"痛贯天灵","description":"佛耶戈遗弃他当前占据的任一灵魂并传送。在抵达时，他会攻击当前生命值百分比最低的英雄，暂时使其减速99%并造成120%【攻击力】+(【12/16/20】+5%【额外攻击力】)%已损失生命值的物理伤害。附近的其他敌人会被击退并受到120%【攻击力】物理伤害。\n这个技能会对主要目标施加攻击特效并对其他的敌人施加技能效果。\n伤害受益于暴击几率和暴击伤害，效能为70%。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/ViegoR.png","abilityVideoPath":"champion-abilities/0234/ability_0234_R1.webm","dynamicDescription":"佛耶戈传送到一个附近的位置并在抵达时处决一名敌方英雄，将其心脏击碎并在其周围引发一阵毁灭性的冲击波来击退其友军。","cost":"0/0/0","costburn":"0/0/0","cooldown":"120/100/80","cooldownburn":"120/100/80","range":"500/500/500","cooldownupgrade":"120/100/80","costupgrade":"0"},{"heroId":"234","spellKey":"w","name":"千载幽咽","description":"开始蓄力：佛耶戈开始聚集黑雾，自身减速10%。\n释放：佛耶戈向前冲刺并将已聚集的黑雾猛掷出去。对命中的第一个敌人造成(【80/135/190/245/300】+100%【法术强度】)魔法伤害，并基于蓄力时间对其造成0.25到1.25秒晕眩。\n在被打断后，这个技能的冷却时间会被设为3秒。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/ViegoW.png","abilityVideoPath":"champion-abilities/0234/ability_0234_W1.webm","dynamicDescription":"佛耶戈蓄力然后向前冲刺，并释放一个浓缩黑雾之球，来使命中的第一个敌人晕眩。","cost":"0/0/0/0/0","costburn":"0/0/0/0/0","cooldown":"8/8/8/8/8","cooldownburn":"8/8/8/8/8","range":"400/400/400/400/400","cooldownupgrade":"8","costupgrade":"0"}],"version":"16.19","fileName":"234.js","fileTime":"2026-09-28 17:30:57"}