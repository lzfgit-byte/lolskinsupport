ceId":"ef515138-2567-4421-bd40-b544ee1b7cdc"}],"spells":[{"heroId":"1","spellKey":"e","name":"熔岩护盾","description":"安妮为一名友方英雄提供持续3秒的(【60/95/130/165/200】+40%【法术强度】)护盾值，以及在1.5秒里持续衰减的(20%-50%【随等级提升】)移动速度。当护盾处于激活状态时，敌人用攻击或技能对护盾造成伤害时会受到(【25/35/45/55/65】+40%【法术强度】)魔法伤害，每个护盾受到一次伤害。\n提伯斯在被召唤出来时总会获得熔岩护盾的效果。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/AnnieE.png","abilityVideoPath":"champion-abilities/0001/ability_0001_E1.webm","dynamicDescription":"为安妮或一名友军提供一层护盾、一个爆发性的移动速度加成并且对任何用攻击或技能袭击她的敌人造成伤害。","cost":"60/65/70/75/80","costburn":"60/65/70/75/80","cooldown":"10/10/10/10/10","cooldownburn":"10/10/10/10/10","range":"800/800/800/800/800","cooldownupgrade":"10","costupgrade":"60/65/70/75/80"},{"heroId":"1","spellKey":"passive","name":"嗜火","description":"在使用4次技能后，安妮的下一个伤害技能会造成(1.25-1.75【随等级提升】)秒晕眩。\n安妮在游戏开始时和重生时，会带着满层的嗜火。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/passive/Annie_Passive.png","abilityVideoPath":"champion-abilities/0001/ability_0001_P1.webm","dynamicDescription":"在施放4个技能后，安妮的下一次伤害类技能就会对目标造成短暂的晕眩效果。<br><br>安妮在游戏开始时和重生时，会带着满层的【嗜火】。","cost":"","costburn":"","cooldown":"","cooldownburn":"","range":"","cooldownupgrade":"","costupgrade":""},{"heroId":"1","spellKey":"q","name":"碎裂之火","description":"安妮投出一团火球，造成(【80/125/170/215/260】+80%【法术强度】)魔法伤害。如果目标阵亡，那么安妮会返还法力值并缩短50%冷却时间。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/AnnieQ.png","abilityVideoPath":"champion-abilities/0001/ability_0001_Q1.webm","dynamicDescription":"安妮向目标投出注入了法力值的火球，对目标造成魔法伤害。如果目标死于碎裂之火，则碎裂之火消耗的法力值会返还给安妮，且碎裂之火的冷却时间减半。","cost":"60/65/70/75/80","costburn":"60/65/70/75/80","cooldown":"4/4/4/4/4","cooldownburn":"4/4/4/4/4","range":"625/625/625/625/625","cooldownupgrade":"4","costupgrade":"60/65/70/75/80"},{"heroId":"1","spellKey":"r","name":"提伯斯之怒","description":"被动：安妮获得【10%/15%/20%】法术穿透。\n安妮召唤提伯斯，造成(【150/275/400】+75%【法术强度】)魔法伤害。在接下来的45秒里，提伯斯会灼烧附近的敌人，每秒造成(【8/12/16】+4%【法术强度】)魔法伤害。\n提伯斯在以下情况下会变得暴怒：在被召唤出来时、在安妮晕眩一名敌方英雄时、以及在安妮阵亡时。在暴怒状态下，提伯斯获得275%攻击速度和在3秒里持续衰减的100%移动速度。\n再次施放：手动给提伯斯下达指令。\n提伯斯拥有：\n(1150+50%【法术强度】)生命值\n(30~90【随等级提升】)护甲\n(30~90【随等级提升】)魔法抗性\n(30/45/60】+10%【法术强度】)攻击力\n(【0/25/50】)额外移动速度\n","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/AnnieR.png","abilityVideoPath":"champion-abilities/0001/ability_0001_R1.webm","dynamicDescription":"安妮召唤地狱火泰迪：提伯斯为其作战，对目标区域造成伤害，提伯斯也会攻击和烧伤站在它周围的敌人。","cost":"100/100/100","costburn":"100/100/100","cooldown":"130/115/100","cooldownburn":"130/115/100","range":"600/600/600","cooldownupgrade":"130/115/100","costupgrade":"100"},{"heroId":"1","spellKey":"w","name":"焚烧","description":"安妮投射出一阵火焰波，造成(【70/110/150/190/230】+80%【法术强度】)魔法伤害。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/AnnieW.png","abilityVideoPath":"champion-abilities/0001/ability_0001_W1.webm","dynamicDescription":"安妮向锥形区域施放一道烈焰，对区域内的所有敌人造成伤害。","cost":"70/75/80/85/90","costburn":"70/75/80/85/90","cooldown":"7/7/7/7/7","cooldownburn":"7/7/7/7/7","range":"600/600/600/600/600","cooldownupgrade":"7","costupgrade":"70/75/80/85/90"}],"version":"16.19","fileName":"1.js","fileTime":"2026-09-28 17:30:42"}