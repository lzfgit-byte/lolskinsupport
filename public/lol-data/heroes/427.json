eroId":"427","heroName":"翠神","heroTitle":"艾翁","name":"青蛙雨衣 艾翁 烟雨","chromas":"1","chromasBelongId":"427031","isBase":"0","emblemsName":"","description":"","mainImg":"","iconImg":"","loadingImg":"","videoImg":"","sourceImg":"","vedioPath":"","suitType":"","publishTime":"","chromaImg":"https://game.gtimg.cn/images/lol/act/img/skinloading/427/931f7223-566d-4083-b767-2faf9efe16c6.png","centerImg":"","instanceId":"931f7223-566d-4083-b767-2faf9efe16c6"},{"skinId":"427038","heroId":"427","heroName":"翠神","heroTitle":"艾翁","name":"青蛙雨衣 艾翁 丝雨","chromas":"1","chromasBelongId":"427031","isBase":"0","emblemsName":"","description":"","mainImg":"","iconImg":"","loadingImg":"","videoImg":"","sourceImg":"","vedioPath":"","suitType":"","publishTime":"","chromaImg":"https://game.gtimg.cn/images/lol/act/img/skinloading/427/28d2e430-e523-44b2-87c6-e9e88d9a0285.png","centerImg":"","instanceId":"28d2e430-e523-44b2-87c6-e9e88d9a0285"},{"skinId":"427039","heroId":"427","heroName":"翠神","heroTitle":"艾翁","name":"青蛙雨衣 艾翁 夜雨","chromas":"1","chromasBelongId":"427031","isBase":"0","emblemsName":"","description":"","mainImg":"","iconImg":"","loadingImg":"","videoImg":"","sourceImg":"","vedioPath":"","suitType":"","publishTime":"","chromaImg":"https://game.gtimg.cn/images/lol/act/img/skinloading/427/baad8352-996a-4711-a3f7-5380aef3dc61.png","centerImg":"","instanceId":"baad8352-996a-4711-a3f7-5380aef3dc61"}],"spells":[{"heroId":"427","spellKey":"e","name":"种豆得瓜","description":"艾翁为一名友方英雄或小菊提供(【75/115/155/195/235】+50%【法术强度】)护盾值。2秒后，护盾会爆裂，对敌人们造成(【70/90/110/130/150】+80%【法术强度】)魔法伤害和持续2秒的【40%/45%/50%/55%/60%】减速。\n如果在护盾存留时引爆种豆得瓜且没有命中任何敌方英雄，那么该友军将获得持续2秒的(【75/115/155/195/235】+50%【法术强度】)护盾值。\n还可以用在小菊身上。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/IvernE.png","abilityVideoPath":"champion-abilities/0427/ability_0427_E1.webm","dynamicDescription":"艾翁在一个友军身上放置一个护盾，护盾会在短暂延迟后爆炸，减速并伤害敌人。护盾值会在没有命中敌人时刷新。","cost":"70/70/70/70/70","costburn":"70/70/70/70/70","cooldown":"11/10/9/8/7","cooldownburn":"11/10/9/8/7","range":"750/750/750/750/750","cooldownupgrade":"11/10/9/8/7","costupgrade":"70"},{"heroId":"427","spellKey":"passive","name":"森林之友","description":"艾翁不会伤害非史诗级的野怪。艾翁可以转而右键点击一个野怪来创造一片小植被，需花费(94-0【随等级提升】)生命值和(90-0【随等级提升】)法力。\n小植被：\n— 在(40-1【随等级提升】)秒里持续生长。\n— 一旦完全生长，艾翁就可以进行收获，将这个营地放生并赚取金币和经验。\n— 艾翁也可以惩戒小植被来立刻生长并放生该营地，从而赚取金币和经验。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/passive/IvernP.png","abilityVideoPath":"champion-abilities/0427/ability_0427_P1.webm","dynamicDescription":"艾翁无法攻击非史诗野怪，也无法被非史诗野怪攻击。艾翁可以在野怪营地创造神奇的小植被，小植被可以持续成长。当小植被完全成长后，艾翁就可以送走野怪来获得金币和经验。","cost":"","costburn":"","cooldown":"","cooldownburn":"","range":"","cooldownupgrade":"","costupgrade":""},{"heroId":"427","spellKey":"q","name":"根深敌固","description":"艾翁召唤一束荆棘，造成(【80/125/170/215/260】+70%【法术强度】)魔法伤害并禁锢命中的第一个敌人【1.6/1.7/1.8/1.9/2】秒。友军在攻击禁锢的敌人时会冲刺到攻击距离处。\n再次施放：艾翁直接冲刺到这个被禁锢的敌人身边。\n命中非史诗级野怪会使根深敌固的冷却时间缩减50%。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/IvernQ.png","abilityVideoPath":"champion-abilities/0427/ability_0427_Q1.webm","dynamicDescription":"艾翁召唤出一束荆棘，对命中的敌方单位造成伤害和禁锢效果。艾翁的友军可以突进到禁锢目标附近。","cost":"60/60/60/60/60","costburn":"60/60/60/60/60","cooldown":"14/13/12/11/10","cooldownburn":"14/13/12/11/10","range":"1125/1125/1125/1125/1125","cooldownupgrade":"14/13/12/11/10","costupgrade":"60"},{"heroId":"427","spellKey":"r","name":"小菊！","description":"艾翁召唤出他的护卫好友小菊跃入纷争，持续45秒。\n小菊，猛击!：小菊对相同英雄或史诗级野怪的每第3次连续的攻击将发出一道冲击波，对命中的所有敌人造成 (【90/140/190】+50%【法术强度】)魔法伤害和1秒击飞。这个效果每3秒仅触发一次。\n再次施放：指示小菊进行攻击或移动。\n小菊拥有：\n(1000-4400【随等级提升】+50%【法术强度】)生命值\n(30-90【随等级提升】)护甲\n(30-90【随等级提升】)魔法抗性\n(【70/100/130】+15%【法术强度】)攻击力\n","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/IvernR.png","abilityVideoPath":"champion-abilities/0427/ability_0427_R1.webm","dynamicDescription":"艾翁召唤他的护卫好友小菊来与他并肩战斗。再次施放即可指挥小菊进行攻击或移动。","cost":"100/100/100","costburn":"100/100/100","cooldown":"140/130/120","cooldownburn":"140/130/120","range":"600/600/600","cooldownupgrade":"140/130/120","costupgrade":"100"},{"heroId":"427","spellKey":"w","name":"揠苗助攻","description":"被动：在草丛中时或离开草丛后的3秒内，艾翁的攻击造成额外的(【20/27.5/35/42.5/50】+20%【法术强度】)魔法伤害。附近的友军们将获得持续1.5秒的此效果，其攻击会因此造成额外的(【10/15/20/25/30】+10%【法术强度】)魔法伤害。\n主动：艾翁生成一片草丛，从而将该区域显形8秒。草丛会存留至艾翁的队伍失去它其中的视野，或至多至45秒。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/IvernW.png","abilityVideoPath":"champion-abilities/0427/ability_0427_W1.webm","dynamicDescription":"在草丛中，艾翁和他附近友军们的攻击将造成额外魔法伤害。艾翁可以激活这个技能来创造一块草丛。","cost":"30/30/30/30/30","costburn":"30/30/30/30/30","cooldown":"0.5/0.5/0.5/0.5/0.5","cooldownburn":"0.5/0.5/0.5/0.5/0.5","range":"1150/1150/1150/1150/1150","cooldownupgrade":"0.5","costupgrade":"30"}],"version":"16.19","fileName":"427.js","fileTime":"2026-09-28 17:30:59"}