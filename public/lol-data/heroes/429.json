","vedioPath":"","suitType":"","publishTime":"","chromaImg":"https://game.gtimg.cn/images/lol/act/img/skinloading/429/2db12faa-4f24-4720-82ad-29bf7dc5a949.png","centerImg":"","instanceId":"2db12faa-4f24-4720-82ad-29bf7dc5a949"},{"skinId":"429032","heroId":"429","heroName":"复仇之矛","heroTitle":"卡莉丝塔","name":"黎明使者 卡莉丝塔 苍辉","chromas":"1","chromasBelongId":"429024","isBase":"0","emblemsName":"","description":"","mainImg":"","iconImg":"","loadingImg":"","videoImg":"","sourceImg":"","vedioPath":"","suitType":"","publishTime":"","chromaImg":"https://game.gtimg.cn/images/lol/act/img/skinloading/429/d4ac312c-e1f6-4a2c-8fc4-00b31ae60eb6.png","centerImg":"","instanceId":"d4ac312c-e1f6-4a2c-8fc4-00b31ae60eb6"}],"spells":[{"heroId":"429","spellKey":"e","name":"撕裂","description":"被动：卡莉丝塔的长矛会在目标身上存留4秒，可叠加任意次数。\n主动：卡莉丝塔从附近的敌人们身上拔出长矛，造成(【5/15/25/35/45】+70%【攻击力】+65%【法术强度】)外加每根后续长矛(【7/14/21/28/35】+【20%/27.5%/35%/42.5%/50%】【攻击力】 +50%【法术强度】)物理伤害。对命中的敌人们造成持续2秒的(【10%/18%/26%/34%/42%】+0.05%【法术强度】)减速。\n如果这个技能击杀了至少一个目标，那么它的冷却时间会刷新并且它会返还【10/15/20/25/30】法力值。\n这个技能对史诗级野怪造成50%伤害。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/KalistaExpungeWrapper.png","abilityVideoPath":"champion-abilities/0429/ability_0429_E1.webm","dynamicDescription":"攻击时用长矛来刺穿目标。主动激活可以将长矛扯出，造成减速和逐步上升的伤害。","cost":"30/30/30/30/30","costburn":"30/30/30/30/30","cooldown":"0/0/0/0/0","cooldownburn":"0/0/0/0/0","range":"1000/1000/1000/1000/1000","cooldownupgrade":"0","costupgrade":"30"},{"heroId":"429","spellKey":"passive","name":"武术姿态","description":"当卡莉丝塔在攻击的起手阶段时，下达一个移动指令将使她在投掷长矛后朝着这个移动指令的方向冲刺一小段距离。\n卡莉丝塔还会在游戏开始时携带【黑色长矛】，允许她与一名友方英雄永久地成为誓约者。\n卡莉丝塔的攻击无法被取消。\n冲刺距离会随鞋子的品质而提升。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/passive/Kalista_Passive.png","abilityVideoPath":"champion-abilities/0429/ability_0429_P1.webm","dynamicDescription":"如果卡莉丝塔在进行普攻或穿刺的同时被下达了移动指令，那么她会在发起进攻的同时朝着这个移动指令的方向位移小段距离。","cost":"","costburn":"","cooldown":"","cooldownburn":"","range":"","cooldownupgrade":"","costupgrade":""},{"heroId":"429","spellKey":"q","name":"穿刺","description":"卡莉丝塔掷出一支长矛，对命中的第一个目标造成(【10/75/140/205/270 】+105%【攻击力】)物理伤害。如果这个技能击杀了目标，那么长矛会继续前行，将撕裂的层数带给命中的下一个目标。\n卡莉丝塔可以在使用这个技能后使用武术姿态的冲刺。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/KalistaMysticShot.png","abilityVideoPath":"champion-abilities/0429/ability_0429_Q1.webm","dynamicDescription":"扔出一个快速移动的长矛。长矛在击杀敌人后会继续飞行。","cost":"60/65/70/75/80","costburn":"60/65/70/75/80","cooldown":"9/9/9/9/9","cooldownburn":"9/9/9/9/9","range":"1150/1150/1150/1150/1150","cooldownupgrade":"9","costupgrade":"60/65/70/75/80"},{"heroId":"429","spellKey":"r","name":"命运的召唤","description":"卡莉丝塔将她的誓约者置入凝滞状态并将其拖拽到她的身边，至多持续4秒。\n誓约者可以点击来将自己投放出去，在命中第一个英雄时停止并击退所有附近的敌人。如果誓约者命中了一名英雄，则会被放置在与目标相距其最大攻击距离的位置。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/KalistaRx.png","abilityVideoPath":"champion-abilities/0429/ability_0429_R1.webm","dynamicDescription":"卡莉丝塔传送一位友军到自己身边。该友军随后可以冲向一个地点，并击退命中的敌人。","cost":"100/100/100","costburn":"100/100/100","cooldown":"160/140/120","cooldownburn":"160/140/120","range":"1000/1000/1000","cooldownupgrade":"160/140/120","costupgrade":"100"},{"heroId":"429","spellKey":"w","name":"哨兵","description":"被动：当卡莉丝塔和她的誓约者都攻击相同的目标时，她会造成【10%/12%/14%/16%/18%】最大生命值的魔法伤害。这个效果对每个目标有10秒冷却时间并且对非英雄单位有【100/125/150/175/200】的伤害上限。\n主动：卡莉丝塔派出一个幽灵去巡视一个地区，持续3个来回。被发现的敌方英雄会被显形4秒。这个技能有2层充能(【90/80/70/60/50】秒充能时间)。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/KalistaW.png","abilityVideoPath":"champion-abilities/0429/ability_0429_W1.webm","dynamicDescription":"在卡莉丝塔与誓约者一起攻击相同目标时提供额外伤害。<br><br>激活此技能可以派出一个灵魂来侦查道路，将它面前的区域显示在玩家的视野内。","cost":"0/0/0/0/0","costburn":"0/0/0/0/0","cooldown":"30/30/30/30/30","cooldownburn":"30/30/30/30/30","range":"5000/5000/5000/5000/5000","cooldownupgrade":"30","costupgrade":"0"}],"version":"16.19","fileName":"429.js","fileTime":"2026-09-28 17:30:59"}