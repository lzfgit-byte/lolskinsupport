e":"4","costupgrade":"28/26/24/22/20"},{"heroId":"120","spellKey":"r","name":"暗影冲击","description":"赫卡里姆召唤幽魂骑兵并向前冲锋，造成(【150/250/350】+100%【法术强度】)魔法伤害。赫卡里姆会在他冲锋的终点释放一道冲击波，来使敌人们恐惧0.75到1.5秒，随冲锋距离提升。\n赫卡里姆将移动至目标位置，但幽魂骑兵们总会冲完全程。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/HecarimUlt.png","abilityVideoPath":"champion-abilities/0120/ability_0120_R1.webm","dynamicDescription":"赫卡里姆召唤幽魂骑兵向前冲锋，对一条直线上的敌人造成魔法伤害。赫卡里姆会在完成他的冲锋时发出一道冲击波，来使周围的敌人惊慌失措地逃命。","cost":"100/100/100","costburn":"100/100/100","cooldown":"140/120/100","cooldownburn":"140/120/100","range":"50000/50000/50000","cooldownupgrade":"140/120/100","costupgrade":"100"},{"heroId":"120","spellKey":"w","name":"恐惧之灵","description":"赫卡里姆在4秒里对附近的敌人们持续造成共(【80/120/160/200/240】+80%【法术强度】)魔法伤害。\n赫卡里姆获得【5/10/15/20/25】护甲和魔法抗性并治疗自身，治疗数额相当于这些敌人受到的来自赫卡里姆的(25)%伤害和来自赫卡里姆友军的(12.5)%伤害。\n赫卡里姆从小兵或野怪处获得的治疗效果无法超过【120/150/180/210/240】生命值。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/HecarimW.png","abilityVideoPath":"champion-abilities/0120/ability_0120_W1.webm","dynamicDescription":"赫卡里姆获得护甲和魔抗。赫卡里姆对附近敌人造成魔法伤害，并基于敌人所受的伤害来恢复生命值。","cost":"50/55/60/65/70","costburn":"50/55/60/65/70","cooldown":"14/14/14/14/14","cooldownburn":"14/14/14/14/14","range":"525/525/525/525/525","cooldownupgrade":"14","costupgrade":"50/55/60/65/70"}],"version":"16.19","fileName":"120.js","fileTime":"2026-09-28 17:30:54"}