.gtimg.cn/images/lol/act/img/skin/big_f988a0d9-25e6-4e59-bee0-e7455658aa85.jpg","iconImg":"https://game.gtimg.cn/images/lol/act/img/skin/small_f988a0d9-25e6-4e59-bee0-e7455658aa85.jpg","loadingImg":"https://game.gtimg.cn/images/lol/act/img/skinloading/f988a0d9-25e6-4e59-bee0-e7455658aa85.jpg","videoImg":"https://game.gtimg.cn/images/lol/act/img/skinvideo/sp_f988a0d9-25e6-4e59-bee0-e7455658aa85.jpg","sourceImg":"https://game.gtimg.cn/images/lol/act/img/guidetop/guide_f988a0d9-25e6-4e59-bee0-e7455658aa85.jpg","vedioPath":"","suitType":"215","publishTime":"","chromaImg":"","centerImg":"https://game.gtimg.cn/images/lol/act/img/center/f988a0d9-25e6-4e59-bee0-e7455658aa85.jpg","instanceId":"f988a0d9-25e6-4e59-bee0-e7455658aa85"}],"spells":[{"heroId":"526","spellKey":"e","name":"全速冲锋","description":"芮尔和一名友军进行冲锋，获得15%移动速度，这个加成会在面向敌方英雄或彼此时提升至30%，持续3秒。芮尔的下一次攻击或裂阵会引爆一个区域，造成(【5%/5.5%/6%/6.5%/7%】+0.03%)最大生命值魔法伤害。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/RellE.png","abilityVideoPath":"champion-abilities/0526/ability_0526_E1.webm","dynamicDescription":"被动：芮尔获得非战斗状态下的移动速度。<br><br>主动：芮尔和一名友军获得不断升温的移动速度，这个加成会在朝着敌人们和彼此移动时提升至双倍。她的下次攻击会爆炸，造成魔法伤害。<br>","cost":"40/40/40/40/40","costburn":"40/40/40/40/40","cooldown":"14/13/12/11/10","cooldownburn":"14/13/12/11/10","range":"1200/1200/1200/1200/1200","cooldownupgrade":"14/13/12/11/10","costupgrade":"40"},{"heroId":"526","spellKey":"passive","name":"溃敌沉力","description":"芮尔的攻击和技能会窃取3%护甲和3%魔法抗性，持续5秒。最大值：15%。普攻附带(5%【护甲】+5%【魔法抗性】)魔法伤害。\n总会窃取至少(1.5-3.0【随等级提升】)。不会窃取小兵或史诗级野怪。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/RellP.png","abilityVideoPath":"champion-abilities/0526/ability_0526_P1.webm","dynamicDescription":"芮尔的攻击和技能在命中时会造成额外魔法伤害并窃取护甲和魔法抗性。","cost":"","costburn":"","cooldown":"","cooldownburn":"","range":"","cooldownupgrade":"","costupgrade":""},{"heroId":"526","spellKey":"q","name":"裂阵","description":"芮尔戳刺她的骑枪，使目标们晕眩0.65秒、摧毁所有护盾，并造成(【60/100/140/180/220】+60%【法术强度】)魔法伤害。\n不会打破野怪身上的护盾。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/RellQ.png","abilityVideoPath":"champion-abilities/0526/ability_0526_Q1.webm","dynamicDescription":"芮尔对一条直线上的单位们造成魔法伤害，打破他们的护盾并造成晕眩效果。 ","cost":"50/50/50/50/50","costburn":"50/50/50/50/50","cooldown":"11/10.5/10/9.5/9","cooldownburn":"11/10.5/10/9.5/9","range":"600/600/600/600/600","cooldownupgrade":"11/10.5/10/9.5/9","costupgrade":"50"},{"heroId":"526","spellKey":"r","name":"极涌","description":"芮尔喷发出有磁性的怒火，粗暴地将附近敌方英雄向她拉拽。随后芮尔会持续将附近敌人向她拖曳并在接来的2秒里持续造成共(【150/250/350】+110%【法术强度】)魔法伤害。\n","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/RellR.png","abilityVideoPath":"champion-abilities/0526/ability_0526_R1.webm","dynamicDescription":"芮尔喷发出有磁性的怒火，粗暴地将附近敌方英雄向她拉拽。随后芮尔会持续将附近敌人向她拖曳一小段时间，并持续造成魔法伤害。","cost":"100/100/100","costburn":"100/100/100","cooldown":"120/100/80","cooldownburn":"120/100/80","range":"200/200/200","cooldownupgrade":"120/100/80","costupgrade":"100"},{"heroId":"526","spellKey":"w","name":"驭铁术：轰落","description":"被动-铁骑疾行：芮尔在骑乘状态时获得【15/25/30/35/40】移动速度。\n主动-驭铁术：轰落：芮尔化马为甲，击飞敌人并造成(【60/90/120/150/180】+60%【法术强度】)魔法伤害。\n芮尔获得(【20/40/60/80/100】 +11%【最大生命值】)护盾值，持续到她再次上马为止。\n芮尔随后进入披甲形态，获得15%提升护甲和法抗性、20%攻击速度和75攻击距离。\n在披甲形态中，她可以使用驭铁术：驾临。\n主动-驭铁术：驾临：芮尔化甲为马并暂时获得持续衰减的30%移动速度。她在3.5秒内的下次攻击会将敌人击飞并投掷到她身后，造成额外的(【10/25/40/55/70】 +40%)魔法伤害。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/RellW.png","abilityVideoPath":"champion-abilities/0526/ability_0526_W1.webm","dynamicDescription":"骑乘状态：芮尔化马为甲，以披甲状态向下轰落，击飞敌人们并获得高额护盾值。在披甲状态下，她获得护甲、魔法抗性、攻击速度和攻击距离，但移动速度缓慢。<br><br>披甲状态：芮尔化甲为马，提供爆发性的移动速度并且她的下一次攻击会对敌人造成击飞效果。<br><br>","cost":"40/40/40/40/40","costburn":"40/40/40/40/40","cooldown":"10/10/10/10/10","cooldownburn":"10/10/10/10/10","range":"450/450/450/450/450","cooldownupgrade":"10","costupgrade":"40"}],"version":"16.19","fileName":"526.js","fileTime":"2026-09-28 17:31:00"}