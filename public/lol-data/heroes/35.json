n/images/lol/act/img/center/5d6dc705-c838-4229-aada-9cb4890d29ba.jpg","instanceId":"5d6dc705-c838-4229-aada-9cb4890d29ba"},{"skinId":"35072","heroId":"35","heroName":"恶魔小丑","heroTitle":"萨科","name":"至臻 万魔殿 萨科 至强","chromas":"1","chromasBelongId":"35071","isBase":"0","emblemsName":"","description":"","mainImg":"","iconImg":"","loadingImg":"","videoImg":"","sourceImg":"","vedioPath":"","suitType":"","publishTime":"","chromaImg":"https://game.gtimg.cn/images/lol/act/img/skinloading/35/d6aeefbb-603a-40c7-8265-1403ead7c4a4.png","centerImg":"","instanceId":"d6aeefbb-603a-40c7-8265-1403ead7c4a4"}],"spells":[{"heroId":"35","spellKey":"e","name":"双面毒刃","description":"被动：当这个技能未进入冷却阶段时，萨科的攻击会对目标造成持续2秒的【20%/22.5%/25%/27.5%/30%】减速。\n主动：萨科扔出一把毒刃，造成(【70/95/120/145/170】 +80% 【额外攻击力】+60%【法术强度】)魔法伤害和持续3秒的(【20%/22.5%/25%/27.5%/30%】)减速。如果目标低于30%生命值，毒刃会转而造成(【105/142.5/180/217.5/255】+120%【额外攻击力】 +90%【法术强度】)伤害。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/TwoShivPoison.png","abilityVideoPath":"champion-abilities/0035/ability_0035_E1.webm","dynamicDescription":"萨科的毒刃在命中时会被动地使目标中毒，减少目标的移动速度。他可以将毒刃扔向目标，造成伤害和中毒效果。扔出的毒刃会对生命值低于30%的目标造成额外伤害。","cost":"75/75/75/75/75","costburn":"75/75/75/75/75","cooldown":"8/8/8/8/8","cooldownburn":"8/8/8/8/8","range":"625/625/625/625/625","cooldownupgrade":"8","costupgrade":"75"},{"heroId":"35","spellKey":"passive","name":"背刺","description":"在命中一名没有面朝萨科的敌人时：\n- 萨科的攻击造成额外的(20-35【随等级提升】+20%【额外攻击力】)物理伤害且这个伤害可以暴击。\n- 并且双面毒刃造成额外的(15-50【随等级提升】+10%【法术强度】)魔法伤害，并会在目标低于30%生命值时提升至(23-75【随等级提升】+15%【法术强度】)魔法伤害。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/passive/Jester_CarefulStrikes.png","abilityVideoPath":"champion-abilities/0035/ability_0035_P1.webm","dynamicDescription":"在目标的背后时，萨科的普攻和【E双面毒刃】会造成额外伤害。","cost":"","costburn":"","cooldown":"","cooldownburn":"","range":"","cooldownupgrade":"","costupgrade":""},{"heroId":"35","spellKey":"q","name":"欺诈魔术","description":"萨科传送并变为隐形，持续【2.5/2.75/3/3.25/3.5】秒。使用惊吓魔盒或幻像不会打破隐形。\n萨科在隐形时的下次攻击造成额外的(【25/35/45/55/65】 +60%【额外攻击力】)物理伤害。如果从背后进行打击，那么这个攻击会暴击，造成160%伤害。\n攻击附带的额外伤害可以暴击。\n隐形单位只会被【防御塔】或真实视野显形。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/Deceive.png","abilityVideoPath":"champion-abilities/0035/ability_0035_Q1.webm","dynamicDescription":"萨科进入隐形状态并传送到目标位置。<br><br>他在隐形状态下的第一次普攻将获得增强，造成额外伤害并在目标背后攻击时必定会暴击。","cost":"40/40/40/40/40","costburn":"40/40/40/40/40","cooldown":"13/12.5/12/11.5/11","cooldownburn":"13/12.5/12/11.5/11","range":"400/400/400/400/400","cooldownupgrade":"13/12.5/12/11.5/11","costupgrade":"40"},{"heroId":"35","spellKey":"r","name":"幻像","description":"萨科暂时消失，然后重新出现并制造一个持续18秒的幻像，幻像会在死亡时爆炸，对附近的敌人造成(【150/225/300】 +70%【法术强度】)魔法伤害并生成三个立即触发的小型惊吓魔盒。幻像造成萨科60%的伤害并承受50%额外伤害。小型惊吓魔盒造成(【10/20/30】 +10%【法术强度】)魔法伤害，如果只攻击一个敌人则为(【25/50/75】+15%【法术强度】)魔法伤害，并让敌人恐惧1秒。\n可以通过按住alt键的同时使用鼠标右键或再次施放此技能来控制幻像。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/HallucinateFull.png","abilityVideoPath":"champion-abilities/0035/ability_0035_R1.webm","dynamicDescription":"萨科在身边制造一个自己的幻像，幻像能够攻击周围的敌人（对防御塔造成较少伤害）。在死亡时爆炸，它会爆炸，生成三个小型惊吓魔盒并对附近的敌人造成伤害。","cost":"100/100/100","costburn":"100/100/100","cooldown":"100/90/80","cooldownburn":"100/90/80","range":"200/200/200","cooldownupgrade":"100/90/80","costupgrade":"100"},{"heroId":"35","spellKey":"w","name":"惊吓魔盒","description":"萨科生成一个会在2秒后潜行的陷阱，持续(40 +10%【法术强度】)秒。它会在有敌人靠近或显形时触发，恐惧附近的敌方英雄们【0.5/0.75/1/1.25/1.5】秒，或小兵和野怪2秒。\n一旦激活，陷阱就会在5秒里持续攻击所有附近的敌人们，造成(【10/15/20/25/30】+12%【法术强度】)魔法伤害，如果只攻击一个敌人则为(【25/40/55/70/85】 +18%【法术强度】)伤害。\n惊吓魔盒的攻击对野怪造成额外的【20/35/50/65/80】伤害。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/JackInTheBox.png","abilityVideoPath":"champion-abilities/0035/ability_0035_W1.webm","dynamicDescription":"萨科丢出一个隐形且会动的惊吓魔盒。在触发时，盒子会恐惧附近的敌人，然后对其进行攻击。","cost":"50/55/60/65/70","costburn":"50/55/60/65/70","cooldown":"15/15/15/15/15","cooldownburn":"15/15/15/15/15","range":"500/500/500/500/500","cooldownupgrade":"15","costupgrade":"70/65/60/55/50"}],"version":"16.19","fileName":"35.js