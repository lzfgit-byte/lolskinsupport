https://game.gtimg.cn/images/lol/act/img/center/371bf185-f57e-4451-a1ee-283259f64c7f.jpg","instanceId":"371bf185-f57e-4451-a1ee-283259f64c7f"},{"skinId":"24005","heroId":"24","heroName":"武器大师","heroTitle":"贾克斯","name":"百夫长 贾克斯","chromas":"0","chromasBelongId":"0","isBase":"0","emblemsName":"Epic","description":"在一个斗士竞技场中，贾克斯的屡次胜利受到了一位年轻的孩子和忠实粉丝——乔——的庆祝。贾克斯发现乔本人是一位令人难以置信的战士，比贾克斯遇到的任何人都勇敢得多。乔给贾克斯起了个绰号“百夫长贾克斯”，一个让他欣然接受的称号。“这是献给你的，孩子，”贾克斯在他冲进战斗时高声宣告，并高举灯光向乔致敬。","mainImg":"https://game.gtimg.cn/images/lol/act/img/skin/big_c5001121-f732-4b93-9272-522c9f6d1e9c.jpg","iconImg":"https://game.gtimg.cn/images/lol/act/img/skin/small_c5001121-f732-4b93-9272-522c9f6d1e9c.jpg","loadingImg":"https://game.gtimg.cn/images/lol/act/img/skinloading/c5001121-f732-4b93-9272-522c9f6d1e9c.jpg","videoImg":"https://game.gtimg.cn/images/lol/act/img/skinvideo/sp_c5001121-f732-4b93-9272-522c9f6d1e9c.jpg","sourceImg":"https://game.gtimg.cn/images/lol/act/img/guidetop/guide_c5001121-f732-4b93-9272-522c9f6d1e9c.jpg","vedioPath":"","suitType":"167","publishTime":"","chromaImg":"","centerImg":"https://game.gtimg.cn/images/lol/act/img/center/c5001121-f732-4b93-9272-522c9f6d1e9c.jpg","instanceId":"c5001121-f732-4b93-9272-522c9f6d1e9c"},{"skinId":"24006","heroId":"24","heroName":"武器大师","heroTitle":"贾克斯","name":"少林武僧 贾克斯","chromas":"0","chromasBelongId":"0","isBase":"0","emblemsName":"Epic","description":"贾克斯对内心平静的寻求，让他拜访了许多寺庙并接受了各种武术大师的指导。他的暴躁态度经常给他带来麻烦，但贾克斯学会了感激指教。贾克斯以一种平静、战略层面的思维来磨练他的战斗能力，现在的他以一种心体技合为一体的新形态面对每场战斗。","mainImg":"https://game.gtimg.cn/images/lol/act/img/skin/big_499ede72-a82e-4b7a-b5d8-418b5c6a3ade.jpg","iconImg":"https://game.gtimg.cn/images/lol/act/img/skin/small_499ede72-a82e-4b7a-b5d8-418b5c6a3ade.jpg","loadingImg":"https://game.gtimg.cn/images/lol/act/img/skinloading/499ede72-a82e-4b7a-b5d8-418b5c6a3ade.jpg","videoImg":"https://game.gtimg.cn/images/lol/act/img/skinvideo/sp_499ede72-a82e-4b7a-b5d8-418b5c6a3ade.jpg","sourceImg":"https://game.gtimg.cn/images/lol/act/img/guidetop/guide_49