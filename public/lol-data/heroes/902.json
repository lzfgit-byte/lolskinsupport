0/120/130","cooldown":"29/27/25/23/21","cooldownburn":"29/27/25/23/21","range":"350/350/350/350/350","cooldownupgrade":"29/27/25/23/21","costupgrade":"90/100/110/120/130"}],"version":"16.19","fileName":"902.js","fileTime":"2026-09-28 17:31:01"}