2/7054e9f1-992e-4709-99ed-96216f63cd22.png","centerImg":"","instanceId":"7054e9f1-992e-4709-99ed-96216f63cd22"},{"skinId":"202072","heroId":"202","heroName":"戏命师","heroTitle":"烬","name":"绝息圣堂 烬 黑昼交响曲","chromas":"1","chromasBelongId":"202064","isBase":"0","emblemsName":"","description":"","mainImg":"","iconImg":"","loadingImg":"","videoImg":"","sourceImg":"","vedioPath":"","suitType":"","publishTime":"","chromaImg":"https://game.gtimg.cn/images/lol/act/img/skinloading/202/92c4cd5f-cd7e-4c1f-a61f-727811bae753.png","centerImg":"","instanceId":"92c4cd5f-cd7e-4c1f-a61f-727811bae753"}],"spells":[{"heroId":"202","spellKey":"e","name":"万众倾倒","description":"被动：被烬击杀的英雄，将在其所在位置生成并引爆一个莲花陷阱。\n主动：烬放置一个持续3分钟的隐形莲花陷阱，陷阱会在被敌人踩中时生成一个区域，使区域内的敌人减速35%。在2秒后，陷阱会爆炸，造成(【20/80/140/200/260】+120%【攻击力】+100%【法术强度】)魔法伤害。\n这个技能有2层充能【24/21.5/19/16.5/14】秒刷新时间。\n莲花陷阱在命中时会对小兵和近期被另一个莲花陷阱命中过的敌人造成65%伤害。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/JhinE.png","abilityVideoPath":"champion-abilities/0202/ability_0202_E1.webm","dynamicDescription":"烬放置一个隐形的莲花陷阱，陷阱会在敌人经过时绽放。它会减速附近的敌人，然后爆炸为一阵飘零的花瓣并对敌人造成伤害。<br><br>绚葬之华 - 当烬击杀掉一名敌方英雄时，一个莲花陷阱将在该英雄的尸体附近爆炸。","cost":"30/30/30/30/30","costburn":"30/30/30/30/30","cooldown":"2/2/2/2/2","cooldownburn":"2/2/2/2/2","range":"750/750/750/750/750","cooldownupgrade":"2","costupgrade":"30"},{"heroId":"202","spellKey":"passive","name":"低语","description":"烬的手枪有着已被固定的攻击速度，并且在发射4次后就得重新装弹。第4颗子弹总会产生暴击并造成相当于目标(15%-25%【随等级提升】)已损失生命值的额外物理伤害。\n此外：\n- 烬获得(4%-44%【随等级提升】+35%【暴击率】+30%【额外攻速】)额外攻击力\n- 烬的暴击造成的伤害减少25%，但会为他提供(14% +44%【额外攻速】)移动速度，持续2秒。\n攻击力会从暴击几率和攻击速度加成中获益。\n移动速度会从攻击速度加成中获益。\n对野怪的已损失生命值封顶为800。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/passive/Jhin_P.png","abilityVideoPath":"champion-abilities/0202/ability_0202_P1.webm","dynamicDescription":"烬的手枪，“低语”，是一台精密的设备，用来造成出色的伤害。它会以一个固定的频率发射子弹，并且只能装四颗子弹。烬会将黑暗魔法注入最后一颗子弹，来让它产生暴击并造成额外斩杀伤害。当“低语”暴击时，它会为烬提供一个爆发性的移动速度加成。","cost":"","costburn":"","cooldown":"","cooldownburn":"","range":"","cooldownupgrade":"","costupgrade":""},{"heroId":"202","spellKey":"q","name":"曼舞手雷","description":"烬扔出一颗手雷，手雷会造成(【44/69/94/119/144】+【44%/51.5%/59%/66.5%/74%】【攻击力】+60%【法术强度】)物理伤害，然后弹跳到附近的一个还未被此技能命中的目标上。\n手雷最多可命中4个目标。手雷每击杀一个单位，它的后续弹跳伤害就会提升35%。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/JhinQ.png","abilityVideoPath":"champion-abilities/0202/ability_0202_Q1.webm","dynamicDescription":"烬朝敌人扔出一颗迷人的手雷。它最多可以命中四个目标，并在每次击杀单位后获得伤害提升。","cost":"40/45/50/55/60","costburn":"40/45/50/55/60","cooldown":"7/6.5/6/5.5/5","cooldownburn":"7/6.5/6/5.5/5","range":"550/550/550/550/550","cooldownupgrade":"7/6.5/6/5.5/5","costupgrade":"40/45/50/55/60"},{"heroId":"202","spellKey":"r","name":"完美谢幕","description":"烬架好武器，固定在原地，并获得4颗超级子弹。每颗超级子弹会在命中第一个敌方英雄时对其造成(【64/128/192】+25%【攻击力】)到(【256/512/768】+100%【攻击力】)物理伤害(伤害会基于目标的已损失生命值而提升)并使其减速80%，持续0.5秒。第四颗子弹会暴击，造成200%伤害。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/JhinR.png","abilityVideoPath":"champion-abilities/0202/ability_0202_R1.webm","dynamicDescription":"烬开始引导，将“低语”切换成一个肩扛式重炮。它能够进行四次超级射击，超级射击的射程极远，可穿透小兵和野怪，但会在命中第一个敌方英雄后停下。“低语”会让命中的敌方单位怯场，也就是对它们造成减速效果和斩杀伤害。第四次射击是经过精心调制的，所以威力特别大，并且必定会造成暴击。","cost":"100/100/100","costburn":"100/100/100","cooldown":"120/105/90","cooldownburn":"120/105/90","range":"25000/25000/25000","cooldownupgrade":"120/105/90","costupgrade":"100"},{"heroId":"202","spellKey":"w","name":"致命华彩","description":"烬进行一次远程射击，对命中的第一个英雄和沿途的其它敌人造成(【70/105/140/175/210】+50%【攻击力】)物理伤害。\n如果被【W致命华彩】命中的敌方英雄在前4秒受到过来自烬的友方英雄的伤害，那么这个英雄还会被禁锢【1.25/1.5/1.75/2/2.25】秒，并为烬提供低语的移动速度加成。\n这个技能对小兵造成75%伤害。\n踩中万众倾倒陷阱的英雄也能被禁锢。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/JhinW.png","abilityVideoPath":"champion-abilities/0202/ability_0202_W1.webm","dynamicDescription":"烬挥舞他的长枪，进行一次射程极远的射击。它可穿透小兵和野怪，但会在命中第一个敌方英雄后停下。如果目标最近踩到了烬的陷阱、承受过烬的伤害或被烬的队友给命中过，那么还会受到禁锢效果。","cost":"50/55/60/65/70","costburn":"50/55/60/65/70","cooldown":"12/12/12/12/12","cooldownburn":"12/12/12/12/12","range":"3000/3000/3000/3000/3000","cooldownupgrade":"12","costupgrade":"50/55/60/65/70"}],"version":"16.19","fileName":"202.js","fileTime":"2026-09-28 17:30:56"}