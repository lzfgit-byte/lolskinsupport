BelongId":"412059","isBase":"0","emblemsName":"","description":"","mainImg":"","iconImg":"","loadingImg":"","videoImg":"","sourceImg":"","vedioPath":"","suitType":"","publishTime":"","chromaImg":"https://game.gtimg.cn/images/lol/act/img/skinloading/412/016d31b4-f92d-4ad0-894d-6775810b41b0.png","centerImg":"","instanceId":"016d31b4-f92d-4ad0-894d-6775810b41b0"},{"skinId":"412067","heroId":"412","heroName":"魂锁典狱长","heroTitle":"锤石","name":"洗地专家 锤石 无私","chromas":"1","chromasBelongId":"412059","isBase":"0","emblemsName":"","description":"","mainImg":"","iconImg":"","loadingImg":"","videoImg":"","sourceImg":"","vedioPath":"","suitType":"","publishTime":"","chromaImg":"https://game.gtimg.cn/images/lol/act/img/skinloading/412/d4dd598d-8d61-4a0c-bcf6-05afdd66a613.png","centerImg":"","instanceId":"d4dd598d-8d61-4a0c-bcf6-05afdd66a613"}],"spells":[{"heroId":"412","spellKey":"e","name":"厄运钟摆","description":"被动：锤石的攻击造成额外伤害，伤害值基于与他最后一次攻击相隔的时间。造成(170%【地狱诅咒】)到(170%【地狱诅咒】+【90%/120%/150%/180%/210%】【攻击力】)魔法伤害。\n主动：锤石挥舞他的锁链，沿挥舞的方向拉拽或推挤敌人。还会对命中的敌人们造成持续1秒的【20%/25%/30%/35%/40%]减速和(【65/110/155/200/245】+60%【法术强度】)魔法伤害。\n被动伤害受益于已收集的灵魂数量。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/ThreshE.png","abilityVideoPath":"champion-abilities/0412/ability_0412_E1.webm","dynamicDescription":"锤石会提升攻击伤害，攻击的间歇期越久伤害值越高。在激活此技能时，锤石会挥舞他的锁链，将命中的所有敌人带向锁链挥舞的方向。","cost":"60/65/70/75/80","costburn":"60/65/70/75/80","cooldown":"13/12.25/11.5/10.75/10","cooldownburn":"13/12.25/11.5/10.75/10","range":"500/500/500/500/500","cooldownupgrade":"13/12.25/11.5/10.75/10","costupgrade":"60/65/70/75/80"},{"heroId":"412","spellKey":"passive","name":"地狱诅咒","description":"锤石在走过已死敌人身边的时候，会收集他们的灵魂。每个灵魂为他提供1护甲和1法术强度。\n当前灵魂加成：(100%【地狱诅咒】)法术强度，(100%【地狱诅咒】)护甲。\n英雄和大型小兵总会掉落一个灵魂，而小型小兵和野怪只会有时掉落一个。史诗级野怪掉落2个灵魂。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/passive/Thresh_Passive.png","abilityVideoPath":"champion-abilities/0412/ability_0412_P1.webm","dynamicDescription":"锤石可以收割那些死在他身边的敌人们的灵魂，从而为他提供护甲和法术强度。","cost":"","costburn":"","cooldown":"","cooldownburn":"","range":"","cooldownupgrade":"","costupgrade":""},{"heroId":"412","spellKey":"q","name":"死亡判决","description":"锤石投出他的镰刀，晕眩命中的第一个单位并将其拉拽向锤石1.5秒。镰刀造成(【100/150/200/250/300】 +90%【法术强度】)魔法伤害并且还会在持续期间提供真实视野。\n锤石可以再次施放这个技能来将自身拉拽到敌人处。\n如果这个技能命中了，那么它的冷却时间缩短2秒。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/ThreshQ.png","abilityVideoPath":"champion-abilities/0412/ability_0412_Q1.webm","dynamicDescription":"在激活时，锤石会绑住一名敌方目标，并将该目标拉向锤石。再次激活此技能，会将锤石拉向该目标。","cost":"70/70/70/70/70","costburn":"70/70/70/70/70","cooldown":"19/16.5/14/11.5/9","cooldownburn":"19/16.5/14/11.5/9","range":"1075/1075/1075/1075/1075","cooldownupgrade":"19/16.5/14/11.5/9","costupgrade":"70"},{"heroId":"412","spellKey":"r","name":"幽冥监牢","description":"锤石生成一个由灵魂墙体组成的监牢，对英雄造成持续2秒的99%减速和(【250/400/550】+100%【法术强度】)魔法伤害。墙体一经碰撞就会被打破，并且一旦被打破一面墙体，剩余的就不会造成伤害且减速时长减半。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/ThreshRPenta.png","abilityVideoPath":"champion-abilities/0412/ability_0412_R1.webm","dynamicDescription":"构建一座监牢，其墙壁在被敌方单位打破时对该敌方单位造成伤害和减速效果。","cost":"100/100/100","costburn":"100/100/100","cooldown":"120/100/80","cooldownburn":"120/100/80","range":"450/450/450","cooldownupgrade":"120/100/80","costupgrade":"100"},{"heroId":"412","spellKey":"w","name":"魂引之灯","description":"锤石扔出他的灯笼，允许一名友军点击它来冲刺到锤石处。\n灯笼也会提供持续4秒的(【50/70/90/110/130】+200%【地狱诅咒】)护盾值给锤石和前去触摸灯笼的第一个友方英雄。\n护盾值受益于已收集的灵魂数量。锤石可以用他的灯笼来拾取灵魂。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/ThreshW.png","abilityVideoPath":"champion-abilities/0412/ability_0412_W1.webm","dynamicDescription":"锤石扔出一个灯笼来为周围友军武装一层抵挡伤害的护盾。友军可以通过点击灯笼来冲到锤石身边。","cost":"50/55/60/65/70","costburn":"50/55/60/65/70","cooldown":"21/20/19/18/17","cooldownburn":"21/20/19/18/17","range":"950/950/950/950/950","cooldownupgrade":"21/20/19/18/17","costupgrade":"50/55/60/65/70"}],"version":"16.19","fileName":"412.js","fileTime":"2026-09-28 17:30:59"}