img/skinloading/127/a5bce466-8029-41b5-9b58-f17c8e69868b.png","centerImg":"","instanceId":"a5bce466-8029-41b5-9b58-f17c8e69868b"}],"spells":[{"heroId":"127","spellKey":"e","name":"冰川之径","description":"丽桑卓向前放出一个冰爪，造成(【70/105/140/175/210】+60%【法术强度】)魔法伤害。丽桑卓可以在冰爪飞行时再次施放来传送到它所在的位置。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/LissandraE.png","abilityVideoPath":"champion-abilities/0127/ability_0127_E1.webm","dynamicDescription":"丽桑卓召唤一个寒冰魔爪来造成魔法伤害。再次激活这个技能，可以让丽桑卓传送到寒冰魔爪的当前位置上。","cost":"80/85/90/95/100","costburn":"80/85/90/95/100","cooldown":"24/21/18/15/12","cooldownburn":"24/21/18/15/12","range":"1050/1050/1050/1050/1050","cooldownupgrade":"24/21/18/15/12","costupgrade":"80/85/90/95/100"},{"heroId":"127","spellKey":"passive","name":"冰脉驱役","description":"当一名敌方英雄在丽桑卓附近阵亡时，该英雄会变成一个冰霜丧尸来寻找活着的敌人们。这些丧尸附近的敌人们会被减速25%。在4秒后，冰霜丧尸会爆炸，造成(120-520【随等级提升】 +50%【法术强度】)魔法伤害。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/passive/Lissandra_Passive.png","abilityVideoPath":"champion-abilities/0127/ability_0127_P1.webm","dynamicDescription":"当一名敌方英雄在丽桑卓附近阵亡时，该英雄会变成一个冰封奴仆。冰封奴仆会寻找活着的敌人，使身边敌人的移动速度减少。在一段延迟后，冰封奴仆会从极度冰寒中粉碎，对附近目标造成魔法伤害。","cost":"","costburn":"","cooldown":"","cooldownburn":"","range":"","cooldownupgrade":"","costupgrade":""},{"heroId":"127","spellKey":"q","name":"寒冰碎片","description":"丽桑卓扔出一杆冰矛，冰矛会在命中第一个敌人后碎裂，造成(【80/115/150/185/220】 +75%【法术强度】)魔法伤害、持续1.5秒的【20%/24%/28%/32%/36%】减速，并且还会对该敌人身后的敌人们造成伤害和减速。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/LissandraQ.png","abilityVideoPath":"champion-abilities/0127/ability_0127_Q1.webm","dynamicDescription":"掷出一杆冰矛，冰矛会在命中敌人时碎裂，造成魔法伤害和减速效果。碎裂会穿过目标，对被冰矛命中的其他敌人造成等量伤害。","cost":"55/60/65/70/75","costburn":"55/60/65/70/75","cooldown":"7/6/5/4/3","cooldownburn":"7/6/5/4/3","range":"725/725/725/725/725","cooldownupgrade":"7/6/5/4/3","costupgrade":"55/60/65/70/75"},{"heroId":"127","spellKey":"r","name":"冰封陵墓","description":"丽桑卓将她自身或一名敌方英雄表进黑冰之中。敌人会被晕眩1.5秒。在自我施放时，丽桑卓进入凝滞状态2.5秒并回复(【100/150/200】+55%【法术强度】)生命值，每1%已损失生命值会使回复量提升1%。\n之后，黑冰会从目标处开始蔓延，造成(【150/250/350】+75%【法术强度】)魔法伤害。黑冰存在3秒，会使敌人减速【45%/60%/75%】。\n凝滞状态中的单位无法移动或行动，并且免疫伤害和不可被选取。\n这个技能会使敌人中断位移。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/LissandraR.png","abilityVideoPath":"champion-abilities/0127/ability_0127_R1.webm","dynamicDescription":"如果对敌方英雄施放，那么会冻结目标，对目标造成晕眩效果，如果对丽桑卓自己施放，那么她会暂时用暗黑之冰裹住自己，治疗自身并免疫任何伤害且不可被选取，但也无法进行任何动作。暗黑之冰可以从目标处放射寒芒对敌人造成魔法伤害和减速效果。","cost":"100/100/100","costburn":"100/100/100","cooldown":"120/100/80","cooldownburn":"120/100/80","range":"550/550/550","cooldownupgrade":"120/100/80","costupgrade":"100"},{"heroId":"127","spellKey":"w","name":"冰霜之环","description":"丽桑卓生成一个冰封领域，禁锢附近的敌人们【1.25/1.35/1.45/1.55/1.65】秒并造成(【70/105/140/175/210】+70%【法术强度】)魔法伤害。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/LissandraW.png","abilityVideoPath":"champion-abilities/0127/ability_0127_W1.webm","dynamicDescription":"将周围的敌人冻在原地，造成魔法伤害和束缚效果。","cost":"40/40/40/40/40","costburn":"40/40/40/40/40","cooldown":"10/9.5/9/8.5/8","cooldownburn":"10/9.5/9/8.5/8","range":"450/450/450/450/450","cooldownupgrade":"10/9.5/9/8.5/8","costupgrade":"40"}],"version":"16.19","fileName":"127.js","fileTime":"2026-09-28 17:30:54"}