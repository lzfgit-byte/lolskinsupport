n":"80/75/70","cooldownburn":"80/75/70","range":"800/800/800","cooldownupgrade":"80/75/70","costupgrade":"100"},{"heroId":"221","spellKey":"w","name":"强穿激光","description":"泽丽发射一道电能脉冲，来对首个命中的敌人造成(【30/70/110/150/190】+100%【攻击力】+50%【法术强度】)物理伤害和持续2秒的【30%/35%/40%/45%/50%】减速。如果脉冲命中了地形，那么它会延伸为一道激光并在一个区域内施加效果并对英雄和野怪产生暴击以造成(【45/105/165/225/285】+150%【攻击力】+75%【法术强度】)物理伤害。\n这个技能的施放时间会随着攻击速度的提升而缩短。\n强化伤害受益于暴击几率和暴击伤害，效能为50%。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/ZeriW.png","abilityVideoPath":"z3317piflzl","dynamicDescription":"泽丽发射一道电能脉冲，来对首个命中的敌人造成减速和伤害。如果脉冲命中了一个墙体，那么它会延伸为一道长程激光。","cost":"50/60/70/80/90","costburn":"50/60/70/80/90","cooldown":"12/11/10/9/8","cooldownburn":"12/11/10/9/8","range":"1150/1150/1150/1150/1150","cooldownupgrade":"12/11/10/9/8","costupgrade":"50/60/70/80/90"}],"version":"16.19","fileName":"221.js","fileTime":"2026-09-28 17:30:57"}