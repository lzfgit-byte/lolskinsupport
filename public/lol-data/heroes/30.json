ooldown":"200/180/160","cooldownburn":"200/180/160","range":"10000/10000/10000","cooldownupgrade":"200/180/160","costupgrade":"100"},{"heroId":"30","spellKey":"w","name":"痛苦之墙","description":"卡尔萨斯生成一个持续5秒的墙体。穿过它的敌人们会受到25%魔法抗性削减，持续5秒，以及在此期间持续衰减的【40%/50%/60%/70%/80%】减速。\n墙体宽度：【800/900/1000/1100/1200】","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/KarthusWallOfPain.png","abilityVideoPath":"champion-abilities/0030/ability_0030_W1.webm","dynamicDescription":"卡尔萨斯创造一道可通过的魔能之墙。所有穿过墙体的敌方单位都会被暂时降低移动速度和魔法抗性。","cost":"70/70/70/70/70","costburn":"70/70/70/70/70","cooldown":"15/15/15/15/15","cooldownburn":"15/15/15/15/15","range":"1000/1000/1000/1000/1000","cooldownupgrade":"15","costupgrade":"70"}],"version":"16.19","fileName":"30.js","fileTime":"2026-09-28 17:30:46"}