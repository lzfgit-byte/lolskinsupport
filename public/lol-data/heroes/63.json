me.gtimg.cn/images/lol/act/img/guidetop/guide_dd16ac22-7dc0-464e-b4d9-f17638f0ff87.jpg","vedioPath":"","suitType":"230","publishTime":"","chromaImg":"","centerImg":"https://game.gtimg.cn/images/lol/act/img/center/dd16ac22-7dc0-464e-b4d9-f17638f0ff87.jpg","instanceId":"dd16ac22-7dc0-464e-b4d9-f17638f0ff87"}],"spells":[{"heroId":"63","spellKey":"e","name":"烈火燃烧","description":"布兰德在目标身上引发一阵强力的爆裂，对附近的单位们造成(【55/80/105/130/155】+60%【法术强度】)魔法伤害。\n如果目标带有烈焰焚身，那么扩散距离翻倍。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/BrandE.png","abilityVideoPath":"champion-abilities/0063/ability_0063_E1.webm","dynamicDescription":"布兰德在目标身上引发一阵强力的爆裂至附近的敌人处，造成魔法伤害。如果目标带有【烈焰焚身】效果，那么【E烈火燃烧】的扩散距离翻倍。","cost":"90/90/90/90/90","costburn":"90/90/90/90/90","cooldown":"13/12/11/10/9","cooldownburn":"13/12/11/10/9","range":"625/625/625/625/625","cooldownupgrade":"13/12/11/10/9","costupgrade":"90"},{"heroId":"63","spellKey":"passive","name":"炽热之焰","description":"布兰德的技能会给目标施加烈焰焚身，在4秒里持续造成共2%最大生命值的魔法伤害。\n如果布兰德击杀了一个烈焰焚身的敌人，他会回复(20-40【随等级提升】)法力。炽热之焰可以至多叠加3次。\n当一个英雄或大型野怪达到3层时，炽热之焰就会在2秒后爆炸，对周围的敌人们造成(6.00%-12.00%【随等级提升】 +0.02%【法术强度】)最大生命值的魔法伤害。\n这个技能对野怪造成额外伤害，至多至每秒50伤害，对史诗级野怪提升至80。\n由第三层烈焰焚身引发的爆炸对野怪的伤害封顶值为270【随等级提升】","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/passive/BrandP.png","abilityVideoPath":"champion-abilities/0063/ability_0063_P1.webm","dynamicDescription":"布兰德的技能会对他的目标施加【烈焰焚身】效果，在4秒里持续造成伤害，最多可叠加3次。如果布兰德击杀了身上带有【烈焰焚身】的敌人，那么他会回复法力值。当【炽热之焰】在一名英雄或大型野怪身上叠至满层时，它会变得不稳定。它会在2秒内爆炸，在目标附近的区域施加法术特效并造成大量伤害。","cost":"","costburn":"","cooldown":"","cooldownburn":"","range":"","cooldownupgrade":"","costupgrade":""},{"heroId":"63","spellKey":"q","name":"火焰烙印","description":"布兰德放出一团火球，对命中的第一个敌人造成(【70/100/130/160/190】 +65%【法术强度】)魔法伤害。\n如果目标被烈焰焚身，那么还会被晕眩1.75秒。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/BrandQ.png","abilityVideoPath":"champion-abilities/0063/ability_0063_Q1.webm","dynamicDescription":"布兰德向前方放出一团可造成魔法伤害的火球。如果目标带有【烈焰焚身】效果，那么【Q火焰烙印】将使目标晕眩。","cost":"70/70/70/70/70","costburn":"70/70/70/70/70","cooldown":"8/7.5/7/6.5/6","cooldownburn":"8/7.5/7/6.5/6","range":"1050/1050/1050/1050/1050","cooldownupgrade":"8/7.5/7/6.5/6","costupgrade":"70"},{"heroId":"63","spellKey":"r","name":"烈焰风暴","description":"布兰德释放一颗破坏力极强的火焰之种，火焰之种会在布兰德或另一名敌人之间弹跳至多5次，每次弹跳时对敌人造成(【100/175/250】 +30%【法术强度】)魔法伤害。弹跳会优先以带有即将满层的炽热之焰效果的英雄为目标。\n如果目标带有烈焰焚身，则会被暂时减速【30%/45%/60%】。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/BrandR.png","abilityVideoPath":"champion-abilities/0063/ability_0063_R1.webm","dynamicDescription":"布兰德释放一颗破坏力极强的火焰之种，火焰之种会在布兰德和附近敌人之间弹跳至多5次，每次弹跳时对敌人造成魔法伤害。弹跳会优先以带有即将满层的【炽热之焰】效果的英雄为目标。如果目标带有【烈焰焚身】效果，那么【R烈焰风暴】将使目标短暂减速。","cost":"100/100/100","costburn":"100/100/100","cooldown":"100/90/80","cooldownburn":"100/90/80","range":"750/750/750","cooldownupgrade":"100/90/80","costupgrade":"100"},{"heroId":"63","spellKey":"w","name":"烈焰之柱","description":"布兰德生成一团纯火之柱，造成(【75/120/165/210/255】 +70%【法术强度】)魔法伤害。\n被烈焰焚身的单位们会转而受到(【93.75/150/206.25/262.5/318.75】 +87.5%【法术强度】)伤害。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/BrandW.png","abilityVideoPath":"champion-abilities/0063/ability_0063_W1.webm","dynamicDescription":"在短暂的延迟后，布兰德会在目标区域创造一根烈焰之柱，来对范围内的敌方单位造成魔法伤害。带有【烈焰焚身】效果的单位会额外受到25%伤害。","cost":"60/70/80/90/100","costburn":"60/70/80/90/100","cooldown":"10/9.5/9/8.5/8","cooldownburn":"10/9.5/9/8.5/8","range":"900/900/900/900/900","cooldownupgrade":"10/9.5/9/8.5/8","costupgrade":"60/70/80/90/100"}],"version":"16.19","fileName":"63.js","fileTime":"2026-09-28 17:30:49"}