nterImg":"https://game.gtimg.cn/images/lol/act/img/center/9966ed08-aad5-4255-90bd-f18a6e5ffc83.jpg","instanceId":"9966ed08-aad5-4255-90bd-f18a6e5ffc83"}],"spells":[{"heroId":"72","spellKey":"e","name":"以绪塔尔冲击","description":"斯卡纳向前冲锋，朝着所选方向行驶并无视地形。如果斯卡纳碰上了一个英雄或大型野怪，那么他会在冲锋的剩余期间对其进行拖拽。拖着一个敌人碰撞到一个墙体时，会对该敌人造成(【30/60/90/120/150】 +6%【生命值】)物理伤害和1.1秒晕眩。\n斯卡纳可以再次释放这个技能来提前结束他的冲锋。\n成功碰撞墙体会使这个技能的冷却时间降至65%。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/SkarnerFracture.png","abilityVideoPath":"champion-abilities/0072/ability_0072_E1.webm","dynamicDescription":"斯卡纳向前冲锋并穿过地形。如果他撞击到一个英雄或大型野怪，则可将其猛推到他命中的下一个墙体上，造成伤害和晕眩效果。","cost":"50/55/60/65/70","costburn":"50/55/60/65/70","cooldown":"22/21/20/19/18","cooldownburn":"22/21/20/19/18","range":"1700/1700/1700/1700/1700","cooldownupgrade":"22/21/20/19/18","costupgrade":"50/55/60/65/70"},{"heroId":"72","spellKey":"passive","name":"战栗","description":"斯卡纳的普通攻击、撼地、擎天和毒刺贯体都会施加持续4秒的战栗效果。在3层战栗时敌人们会在其持续期间内受到(5.0%-9.0%【随等级提升】)最大生命值魔法伤害。\n对野怪的总伤害上限为(100-300【随等级提升】)","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/Skarner_Passive.png","abilityVideoPath":"champion-abilities/0072/ability_0072_P1.webm","dynamicDescription":"斯卡纳的普通攻击、撼地、擎天和毒刺贯体都会施加战栗效果。在满层战栗时，敌人们会在其持续期间内受到最大生命值魔法伤害。","cost":"","costburn":"","cooldown":"","cooldownburn":"","range":"","cooldownupgrade":"","costupgrade":""},{"heroId":"72","spellKey":"q","name":"撼地 / 擎天","description":"斯卡纳从地面掘出一块巨石，使他的下三次攻击拥有【20%/25%/30%/35%/40%】攻击速度并且对附近敌人们造成(【10/20/30/40/50】+90%【额外攻击力】+3%【额外生命值】)物理伤害。 他的最后一次攻击将对被影响的敌人们造成额外的11%最大生命值物理伤害和持续1秒的40%减速。\n再次施放：斯卡纳结束这个技能并扔出他的巨石，对命中的第一个敌人——及其周围的其它敌人们——造成(【10/20/30/40/50】 +90% 【额外攻击力】+3% 【额外生命值】)+11%最大生命值物理伤害和持续1秒的40%减速。\n对野怪的百分比生命值伤害上限为【150/200/250/300/350】。\n这个技能对建筑物造成100%伤害。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/SkarnerVirulentSlash.png","abilityVideoPath":"champion-abilities/0072/ability_0072_Q1.webm","dynamicDescription":"斯卡纳从地面掘出一块巨石来强化他的普攻，这块巨石可作为飞弹投掷。","cost":"30/30/30/30/30","costburn":"30/30/30/30/30","cooldown":"8/6.75/5.5/4.25/3","cooldownburn":"8/6.75/5.5/4.25/3","range":"400/400/400/400/400","cooldownupgrade":"8/6.75/5.5/4.25/3","costupgrade":"30"},{"heroId":"72","spellKey":"r","name":"毒刺贯体","description":"斯卡纳向前甩出他的尾巴，对最先命中的3个英雄造成(【150/250/350】 +100%【法术强度】)魔法伤害和1.5秒压制。那些被命中的英雄会在这个技能的持续期间被斯卡纳拖行。\n如果斯卡纳至少命中了一个英雄，那么他会获得持续1.5秒的40%移动速度\n如果撼地处于激活状态，那么斯卡纳将先施放擎天。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/SkarnerImpale.png","abilityVideoPath":"champion-abilities/0072/ability_0072_R1.webm","dynamicDescription":"斯卡纳向前甩出他的尾巴，以压制敌方英雄们。一旦被压制，猎物们就会在斯卡纳移动时被拖行。","cost":"100/100/100","costburn":"100/100/100","cooldown":"120/105/90","cooldownburn":"120/105/90","range":"625/625/625","cooldownupgrade":"120/105/90","costupgrade":"100"},{"heroId":"72","spellKey":"w","name":"震地壁垒","description":"斯卡纳获得持续2.5秒的(8%【生命值】)护盾值并引发一阵地震，来对附近的敌人们造成(【50/70/90/110/130】 +80%【法术强度】)魔法伤害和持续1秒的20%减速。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/SkarnerExoskeleton.png","abilityVideoPath":"champion-abilities/0072/ability_0072_W1.webm","dynamicDescription":"斯卡纳获得一个护盾并生成一阵地震，地震的冲击波会伤害并减速敌人们。","cost":"60/65/70/75/80","costburn":"60/65/70/75/80","cooldown":"10/9/8/7/6","cooldownburn":"10/9/8/7/6","range":"700/700/700/700/700","cooldownupgrade":"10/9/8/7/6","costupgrade":"60/65/70/75/80"}],"version":"16.19","fileName":"72.js","fileTime":"2026-09-28 17:30:49"}