chromaImg":"","centerImg":"https://game.gtimg.cn/images/lol/act/img/center/6e1a05d4-1fbc-44b0-9bdb-491991a74f04.jpg","instanceId":"6e1a05d4-1fbc-44b0-9bdb-491991a74f04"},{"skinId":"72001","heroId":"72","heroName":"上古领主","heroTitle":"斯卡纳","name":"沙暴巨蝎 斯卡纳","chromas":"0","chromasBelongId":"0","isBase":"0","emblemsName":"common","description":"不要相信草原风中的絮絮低语、回家路上的呢喃哼唱。 迷失的灵魂们先是听到旧沙漠之魔鬼——所谓的任性救助者——一段时间后他们就会感受到他地狱般的颤动。他的声音响起，低吟着安全之声，保护之声。拒绝这个魔鬼的曲调——否则就会被罪恶和沙子进行防腐处理，以加入他的木乃伊集群。","mainImg":"https://game.gtimg.cn/images/lol/act/img/skin/big_5d597b5f-b680-4cd9-a319-76c674887de7.jpg","iconImg":"https://game.gtimg.cn/images/lol/act/img/skin/small_5d597b5f-b680-4cd9-a319-76c674887de7.jpg","loadingImg":"https://game.gtimg.cn/images/lol/act/img/skinloading/5d597b5f-b680-4cd9-a319-76c674887de7.jpg","videoImg":"https://game.gtimg.cn/images/lol/act/img/skinvideo/sp_5d597b5f-b680-4cd9-a319-76c674887de7.jpg","sourceImg":"https://game.gtimg.cn/images/lol/act/img/guidetop/guide_5d597b5f-b680-4cd9-a319-76c674887de7.jpg","vedioPath":"","suitType":"39","publishTime":"","chromaImg":"","centerImg":"https://game.gtimg.cn/images/lol/act/img/center/5d597b5f-b680-4cd9-a319-76c674887de7.jpg","instanceId":"5d597b5f-b680-4cd9-a319-76c674887de7"},{"skinId":"72002","heroId":"72","heroName":"上古领主","heroTitle":"斯卡纳","name":"远土之灵 斯卡纳","chromas":"0","chromasBelongId":"0","isBase":"0","emblemsName":"common","description":"斯卡纳曾经是一个古老文明的守护者，却被迫眼睁睁地看着这个文明在他眼前崩溃。他抱有一种孤注一掷的希望，希望有一天他和他的同伴能够重建被摧毁的一切。在那之前，他发誓要保持警惕，阻止任何入侵者们——只要他们胆敢威胁到这片废墟以及脉动于其中的魔法。","mainImg":"https://game.gtimg.cn/images/lol/act/img/skin/big_46779901-f7d9-4421-91f2-8e44999aaafb.jpg","iconImg":"https://game.gtimg.cn/images/lol/act/img/skin/small_46779901-f7d9-4421-91f2-8e44999aaafb.jpg","loadingImg":"https://game.gtimg.cn/images/lol/act/img/skinloading/46779901-f7d9-4421-91f2-8e44999aaafb.jpg","videoImg":"https://game.gtimg.cn/images/lol/act/img/skinvideo/sp_46779901-f7d9-4421-91f2-8e44999aaafb.jpg","sourceImg":"https://game.gtimg.cn/images/lol/act/img/guidetop/guide_46779901-f7d9-4421-91f2-8e44999aaafb.jpg","vedioPath":"","suitType":"","publishTime":"","chromaImg":"","centerImg":"https://game.gtimg.cn/images/lol/act/img/center/46779901-f7d9-4421-91f2-8e44999aaafb.jpg","instanceId":"46779901-f7d9-4421-91f2-8e44999aaafb"},{"skinId":"72003","heroId":"72","heroName":"上古领主","heroTitle":"斯卡纳","name":"战地机甲 斯卡纳","chromas":"0","chromasBelongId":"0","isBase":"0","emblemsName":"Epic","description":"阿尔法斯卡纳作为最早期的原型机，为日后的战地机甲系列铺平了道路。在后期的几代设计中已经看不到斯卡纳充盈的怒火，也许是他的脑部希望敌人能够体会到和他同等程度的痛苦，亦或他只是以杀戮为乐。","mainImg":"https://game.gtimg.cn/images/lol/act/img/skin/big_92ce87fd-63ba-4cc4-a964-8975e56949e2.jpg","iconImg":"https://game.gtimg.cn/images/lol/act/img/skin/small_92ce87fd-63ba-4cc4-a964-8975e56949e2.jpg","loadingImg":"https://game.gtimg.cn/images/lol/act/img/skinloading/92ce87fd-63ba-4cc4-a964-8975e56949e2.jpg","videoImg":"https://game.gtimg.cn/images/lol/act/img/skinvideo/sp_92ce87fd-63ba-4cc4-a964-8975e56949e2.jpg","sourceImg":"https://game.gtimg.cn/images/lol/act/img/guidetop/guide_92ce87fd-63ba-4cc4-a964-8975e56949e2.jpg","vedioPath":"","suitType":"25","publishTime":"","chromaImg":"","centerImg":"https://game.gtimg.cn/images/lol/act/img/center/92ce87fd-63ba-4cc4-a964-8975e56949e2.jpg","instanceId":"92ce87fd-63ba-4cc4-a964-8975e56949e2"},{"skinId":"72004","heroId":"72","heroName":"上古领主","heroTitle":"斯卡纳","name":"沙之守护 斯卡纳","chromas":"0","chromasBelongId":"0","isBase":"0","emblemsName":"common","description":"斯卡纳，被遗忘的君主，远古的沙之守护——我们唤醒它们来保护我们免受恶灵——一个由我们亲手创造的恶灵——的荼毒。让这片圣土无人踏足，以免他们在你的狂怒中支离破碎。","mainImg":"https://game.gtimg.cn/images/lol/act/img/skin/big_60482ef3-ba77-463f-8f58-58ef95527698.jpg","iconImg":"https://game.gtimg.cn/images/lol/act/img/skin/small_60482ef3-ba77-463f-8f58-58ef95527698.jpg","loadingImg":"https://game.gtimg.cn/images/lol/act/img/skinloading/60482ef3-ba77-463f-8f58-58ef95527698.jpg","videoImg":"https://game.gtimg.cn/images/lol/act/img/skinvideo/sp_60482ef3-ba77-463f-8f58-58ef95527698.jpg","sourceImg":"https:/