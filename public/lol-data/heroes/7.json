st":"50/50/50/50/50","costburn":"50/50/50/50/50","cooldown":"6/6/6/6/6","cooldownburn":"6/6/6/6/6","range":"700/700/700/700/700","cooldownupgrade":"6","costupgrade":"50"},{"heroId":"7","spellKey":"r","name":"故技重施","description":"乐芙兰故技重施，将她放过的上一个技能再施放一次。故技重施版技能的伤害会获得提升。\n故技重施版恶意魔印在施加印记时造成(【70/150/230】+40%【法术强度】)魔法伤害，并在消耗印记时造成(【140/300/460】+80%【法术强度】)魔法伤害。\n故技重施版魔影迷踪造成(【150/315/480】+90%【法术强度】)魔法伤害。\n故技重施版幻影锁链在链到目标时造成(【70/150/230】+40%【法术强度】)魔法伤害并在禁锢时造成(【140/300/460】+85%【法术强度】)魔法伤害。","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/LeBlancR.png","abilityVideoPath":"champion-abilities/0007/ability_0007_R1.webm","dynamicDescription":"乐芙兰可以施放她一个技能的故技重施版。","cost":"0/0/0","costburn":"0/0/0","cooldown":"45/35/25","cooldownburn":"45/35/25","range":"25000/25000/25000","cooldownupgrade":"45/35/25","costupgrade":"0"},{"heroId":"7","spellKey":"w","name":"魔影迷踪","description":"乐芙兰冲刺然后对附近的敌人们造成(【75/115/155/195/235】+90%【法术强度】)魔法伤害。在冲刺后的4秒里，乐芙兰可以再次施放。\n再次施放：乐芙兰回到她的初始位置","abilityIconPath":"https://game.gtimg.cn/images/lol/act/img/spell/LeBlancW.png","abilityVideoPath":"champion-abilities/0007/ability_0007_W1.webm","dynamicDescription":"乐芙兰位移至目标位置，并对目标位置附近的敌人造成伤害。在接下来的4秒里，她可以激活此技能来回到她的初始位置。","cost":"60/70/80/90/100","costburn":"60/70/80/90/100","cooldown":"15/13.75/12.5/11.25/10","cooldownburn":"15/13.75/12.5/11.25/10","range":"600/600/600/600/600","cooldownupgrade":"15/13.75/12.5/11.25/10","costupgrade":"60/70/80/90/100"}],"version":"16.19","fileName":"7.js","fileTime":"2026-09-28 17:30:43"}