{
  "name": "lolsupport",
  "version": "4.0.79",
  "main": "dist-electron/main/index.js",
  "license": "MIT",
  "servicePort": 13356,
  "private": true,
  "workspaces": [
    "packages/types",
    "packages/constant"
  ],
  "keywords": [
    "electron",
    "rollup",
    "vite",
    "vue3",
    "vue"
  ],
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:3344/"
    }
  },
  "scripts": {
    "app:dev": "vite",
    "app:build": "npm version patch && vite build && electron-builder",
    "app:prebuild": "vite build && node script/build.js && electron-builder",
    "app:elbuild": "electron-builder",
    "index:gen": "node script/gen-skinbins-index.mjs - D:\\projects\\hash-game\\hashes\\lol\\hashes.game.txt",
    "app:preview": "vite preview",
    "data:gen": "node script/gen-lol-data.mjs --force",
    "ltf:build": "node script/build-ltf.mjs",
    "ltf:test": "node node_modules/esbuild/bin/esbuild electron/export/ltfBridge.ts --bundle --platform=node --format=esm --outfile=test/.tmp/ltfBridge.mjs && node test/ltf-bridge.test.mjs",
    "ltf:session:test": "node node_modules/esbuild/bin/esbuild electron/export/ltfSession.ts --bundle --platform=node --format=esm --outfile=test/.tmp/ltfSession.mjs && node node_modules/esbuild/bin/esbuild electron/export/ltfBridge.ts --bundle --platform=node --format=esm --outfile=test/.tmp/ltfBridge.mjs && node test/ltf-session.test.mjs",
    "ltf:live:test": "node test/ltf-live.test.mjs",
    "zip:test": "node node_modules/esbuild/bin/esbuild electron/utils/zip-archive.ts --bundle --platform=node --format=esm --outfile=test/.tmp/zipArchive.mjs && node test/zip-archive.test.mjs",
    "config:test": "node node_modules/esbuild/bin/esbuild electron/utils/json-config.ts --bundle --platform=node --format=esm --outfile=test/.tmp/jsonConfig.mjs && node test/json-config.test.mjs",
    "skin:test": "node node_modules/esbuild/bin/esbuild electron/export/skin-sync.ts --bundle --platform=node --format=esm --packages=external --outfile=test/.tmp/skinSync.mjs && node test/skin-sync.test.mjs",
    "mesh:test": "node node_modules/esbuild/bin/esbuild electron/export/skin-mesh.ts --bundle --platform=node --format=esm --outfile=test/.tmp/skinMesh.mjs && node test/skin-mesh.test.mjs",
    "audio:test": "node node_modules/esbuild/bin/esbuild electron/export/skin-audio.ts --bundle --platform=node --format=esm --outfile=test/.tmp/skinAudio.mjs && node test/skin-audio.test.mjs",
    "bnk:test": "node node_modules/esbuild/bin/esbuild electron/export/bnk.ts --bundle --platform=node --format=esm --outfile=test/.tmp/bnk.mjs && node test/bnk.test.mjs",
    "banks:test": "node node_modules/esbuild/bin/esbuild electron/export/bnk.ts --bundle --platform=node --format=esm --outfile=test/.tmp/bnk.mjs && node node_modules/esbuild/bin/esbuild electron/export/skin-audio.ts --bundle --platform=node --format=esm --outfile=test/.tmp/skinAudio.mjs && node node_modules/esbuild/bin/esbuild electron/export/skin-banks.ts --bundle --platform=node --format=esm --outfile=test/.tmp/skinBanks.mjs && node test/skin-banks.test.mjs",
    "rebase:test": "node node_modules/esbuild/bin/esbuild electron/export/skin-mesh.ts --bundle --platform=node --format=esm --outfile=test/.tmp/skinMesh.mjs && node node_modules/esbuild/bin/esbuild electron/export/skin-audio.ts --bundle --platform=node --format=esm --outfile=test/.tmp/skinAudio.mjs && node node_modules/esbuild/bin/esbuild electron/export/skin-rebase.ts --bundle --platform=node --format=esm --packages=external --outfile=test/.tmp/skinRebase.mjs && node test/skin-rebase.test.mjs",
    "hash:test": "node node_modules/esbuild/bin/esbuild electron/utils/wad-hash.ts --bundle --platform=node --format=esm --packages=external --outfile=test/.tmp/wadHash.mjs && node test/wad-hash.test.mjs",
    "import:test": "node node_modules/esbuild/bin/esbuild electron/export/league-skins-import.ts --bundle --platform=node --format=esm --outfile=test/.tmp/leagueSkinsImport.mjs && node test/league-skins-import.test.mjs",
    "ritobin:test": "node node_modules/esbuild/bin/esbuild electron/export/ritobin.ts --bundle --platform=node --format=esm --outfile=test/.tmp/ritobin.mjs && node test/ritobin.test.mjs",
    "skincheck:test": "node node_modules/esbuild/bin/esbuild electron/export/skin-check.ts --bundle --platform=node --format=esm --outfile=test/.tmp/skinCheck.mjs && node test/skin-check.test.mjs",
    "wadindex:test": "node node_modules/esbuild/bin/esbuild electron/utils/wad-hash.ts --bundle --platform=node --format=esm --packages=external --outfile=test/.tmp/wadHash.mjs && node node_modules/esbuild/bin/esbuild electron/export/extract-wad-chunks.ts --bundle --platform=node --format=esm --packages=external --outfile=test/.tmp/wadExtract.mjs && node node_modules/esbuild/bin/esbuild electron/export/wad-index.ts --bundle --platform=node --format=esm --packages=external --outfile=test/.tmp/wadIndex.mjs && node test/wad-index.test.mjs",
    "skinid:test": "node node_modules/esbuild/bin/esbuild electron/export/skin-id.ts --bundle --platform=node --format=esm --outfile=test/.tmp/skinId.mjs && node test/skin-id.test.mjs"
  },
